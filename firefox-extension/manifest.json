{
  "manifest_version": 3,
  "name": "TikTok Archive Companion",
  "version": "1.1",
  "description": "Sync TikTok and Instagram cookies to your self-hosted TikTok Archive and queue videos for download.",
  "browser_specific_settings": {
    "gecko": {
      "id": "tiktok-archive-companion@selfhosted.local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["authenticationInfo", "browsingActivity"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "permissions": ["cookies", "storage", "activeTab"],
  "host_permissions": ["*://*.tiktok.com/*", "*://*.instagram.com/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "TikTok Archive"
  }
}
