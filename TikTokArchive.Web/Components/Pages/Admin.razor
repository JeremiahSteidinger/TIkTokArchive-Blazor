    private int AiProviderCount(AiProvider? provider) =>
        provider.HasValue
            ? (aiProviderCounts.TryGetValue(provider.Value, out var c) ? c : 0)
            : aiUnknownProviderCount;

    private static string AiProviderLabel(AiProvider? provider) => provider switch
    {
        AiProvider.Local => "Local",
        AiProvider.Gemini => "Gemini",
        _ => "Unknown"
    };

    private async Task RequeueByProvider(AiProvider? provider)
    {
        if (aiRequeuingProvider) return;

        aiRequeuingProvider = true;
        try
        {
            var count = await AiEnrichmentSvc.RequeueByProviderAsync(provider);
            Toast.Show($"Requeued {count} video(s) enriched by {AiProviderLabel(provider)}", ToastSeverity.Success);
            await LoadAiEnrichmentData();
        }
        catch (Exception ex)
        {
            Toast.Show($"Error requeuing {AiProviderLabel(provider)} videos: {ex.Message}", ToastSeverity.Error);
        }
        finally
        {
            aiRequeuingProvider = false;
        }
    }

    private async Task RequeueGeminiSelection()
    {
        if (aiRequeuingProvider) return;

        aiRequeuingProvider = true;
        try
        {
            int count;
            string label;
            if (string.IsNullOrEmpty(selectedRequeueGeminiModel))
            {
                count = await AiEnrichmentSvc.RequeueByProviderAsync(AiProvider.Gemini);
                label = "Gemini (all models)";
            }
            else
            {
                count = await AiEnrichmentSvc.RequeueByProviderModelAsync(AiProvider.Gemini, selectedRequeueGeminiModel);
                label = $"Gemini · {selectedRequeueGeminiModel}";
            }

            Toast.Show($"Requeued {count} video(s) enriched by {label}", ToastSeverity.Success);
            await LoadAiEnrichmentData();
        }
        catch (Exception ex)
        {
            Toast.Show($"Error requeuing Gemini videos: {ex.Message}", ToastSeverity.Error);
        }
        finally
        {
            aiRequeuingProvider = false;
        }
    }

