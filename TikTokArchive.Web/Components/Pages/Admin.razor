@page "/admin"
@using Microsoft.EntityFrameworkCore
@using TikTokArchive.Entities
@using TikTokArchive.Web.Services
@inject TikTokArchiveDbContext DbContext
@inject ReindexCoordinator ReindexCoordinator
@inject ITranscriptionService TranscriptionSvc
@inject ToastService Toast
@implements IDisposable

<PageTitle>Admin - Configuration</PageTitle>

<h1 class="mb-6 text-2xl font-bold text-ink">Administration</h1>

<div class="mb-5 flex gap-1 border-b border-line">
    <button class="@TabClass(0)" @onclick="@(() => activeTab = 0)">Search Index</button>
    <button class="@TabClass(1)" @onclick="@(() => activeTab = 1)">Local Import</button>
    <button class="@TabClass(2)" @onclick="@(() => activeTab = 2)">Transcription</button>
</div>

@if (activeTab == 0)
{
    <div class="grid gap-4 lg:grid-cols-2">
        <!-- Configuration -->
        <div class="card">
            <h2 class="mb-4 text-base font-semibold text-ink">Configuration</h2>

            <label class="label" for="syncInterval">Sync Interval (minutes)</label>
            <input id="syncInterval" type="number" min="1" max="1440" class="input mb-4"
                   @bind="syncIntervalMinutes" />

            <button class="btn btn-primary" @onclick="SaveConfiguration" disabled="@isSavingConfig">
                @if (isSavingConfig)
                {
                    <span class="spinner size-4"></span>
                }
                Save Configuration
            </button>

            @if (configLastModified.HasValue)
            {
                <p class="mt-2 text-xs text-faint">
                    Last modified: @configLastModified.Value.ToLocalTime().ToString("g")
                </p>
            }
        </div>

        <!-- Bulk Reindex -->
        <div class="card">
            <h2 class="mb-4 text-base font-semibold text-ink">Bulk Reindex</h2>

            <p class="mb-4 text-sm text-muted">
                Rebuild the entire search index from the database. This may take several minutes.
            </p>

            <button class="btn btn-primary" @onclick="StartReindex" disabled="@reindexStatus.IsRunning">
                @if (reindexStatus.IsRunning)
                {
                    <span class="spinner size-4"></span>
                }
                Start Bulk Reindex
            </button>

            @if (reindexStatus.IsRunning)
            {
                <div class="mt-4">
                    <p class="mb-2 text-sm text-muted">
                        Progress: @reindexStatus.ProcessedCount / @reindexStatus.TotalCount
                        (@ReindexPercentage.ToString("F1")%)
                    </p>
                    <div class="h-2 w-full overflow-hidden rounded-full bg-surface-2">
                        <div class="h-full rounded-full bg-sky-500 transition-all"
                             style="@($"width:{(int)ReindexPercentage}%")"></div>
                    </div>
                </div>
            }

            @if (!string.IsNullOrEmpty(reindexStatus.ErrorMessage))
            {
                <div class="alert alert-danger mt-3 items-center">
                    <Icon Name="error" Class="size-5 shrink-0 text-rose-500" />
                    @reindexStatus.ErrorMessage
                </div>
            }
            else if (reindexStatus.CompletedAt.HasValue)
            {
                <div class="alert alert-success mt-3 items-center">
                    <Icon Name="success" Class="size-5 shrink-0 text-emerald-500" />
                    Reindex completed at @reindexStatus.CompletedAt.Value.ToLocalTime().ToString("g")
                </div>
            }
        </div>
    </div>

    <!-- Queue Status -->
    <div class="card mt-4">
        <h2 class="mb-4 text-base font-semibold text-ink">Queue Status</h2>

        <div class="mb-4 flex flex-wrap gap-2">
            <span class="badge badge-info">Pending Operations: @pendingCount</span>
            <span class="badge badge-danger">Retrying Operations: @retryingCount</span>
        </div>

        @if (recentErrors.Any())
        {
            <h3 class="mb-2 text-sm font-semibold text-muted">Recent Errors:</h3>
            <div class="overflow-x-auto rounded-lg border border-line">
                <table class="w-full text-left text-sm">
                    <thead class="bg-surface-2 text-xs uppercase tracking-wide text-muted">
                        <tr>
                            <th class="px-3 py-2 font-medium">Video ID</th>
                            <th class="px-3 py-2 font-medium">Operation</th>
                            <th class="px-3 py-2 font-medium">Retry Count</th>
                            <th class="px-3 py-2 font-medium">Last Attempt</th>
                            <th class="px-3 py-2 font-medium">Error</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-line">
                        @foreach (var error in recentErrors)
                        {
                            <tr class="hover:bg-surface-2">
                                <td class="px-3 py-2 text-ink">@error.VideoId</td>
                                <td class="px-3 py-2 text-ink">@error.OperationType</td>
                                <td class="px-3 py-2 text-ink">@error.RetryCount</td>
                                <td class="whitespace-nowrap px-3 py-2 text-muted">@error.LastAttempt?.ToLocalTime().ToString("g")</td>
                                <td class="px-3 py-2 text-muted">
                                    @(error.ErrorMessage?.Length > 50
                                        ? error.ErrorMessage.Substring(0, 50) + "..."
                                        : error.ErrorMessage)
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
}
else if (activeTab == 1)
{
    <!-- Local Import -->
    <div class="card">
        <div class="mb-4 flex flex-wrap items-center gap-2">
            <h2 class="flex-1 text-base font-semibold text-ink">Import Log</h2>
            <span class="badge badge-success">Success: @localImportSuccessCount</span>
            <span class="badge badge-danger">Failed: @localImportFailedCount</span>
            <button class="btn btn-ghost" @onclick="LoadLocalImportLog">
                <Icon Name="refresh" Class="size-4" /> Refresh
            </button>
        </div>

        @if (localImportLogs.Count == 0)
        {
            <p class="text-sm text-faint">
                No imports recorded yet. Drop video files into the drop folder to get started.
            </p>
        }
        else
        {
            <div class="overflow-x-auto rounded-lg border border-line">
                <table class="w-full text-left text-sm">
                    <thead class="bg-surface-2 text-xs uppercase tracking-wide text-muted">
                        <tr>
                            <th class="px-3 py-2 font-medium">Imported At</th>
                            <th class="px-3 py-2 font-medium">File Name</th>
                            <th class="px-3 py-2 font-medium">Status</th>
                            <th class="px-3 py-2 font-medium">Video ID</th>
                            <th class="px-3 py-2 font-medium">Date Created Used</th>
                            <th class="px-3 py-2 font-medium">Error</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-line">
                        @foreach (var log in PagedImportLogs)
                        {
                            <tr class="hover:bg-surface-2 align-top">
                                <td class="whitespace-nowrap px-3 py-2 text-ink">@log.ImportedAt.ToLocalTime().ToString("g")</td>
                                <td class="px-3 py-2"><span class="break-all text-ink">@log.FileName</span></td>
                                <td class="px-3 py-2">
                                    @if (log.Status == LocalImportStatus.Success)
                                    {
                                        <span class="badge badge-success">Success</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-danger">Failed</span>
                                    }
                                </td>
                                <td class="px-3 py-2 text-xs text-muted">@(log.VideoId ?? "—")</td>
                                <td class="px-3 py-2">
                                    @if (log.DateCreatedUsed.HasValue)
                                    {
                                        @if (log.DateCreatedUsed.Value.Year == 1970)
                                        {
                                            <div class="flex flex-col">
                                                <span class="flex items-center gap-1 text-amber-600 dark:text-amber-400">
                                                    <Icon Name="warning" Class="size-4" />
                                                    @log.DateCreatedUsed.Value.ToLocalTime().ToString("g")
                                                </span>
                                                <span class="text-xs text-amber-600/80 dark:text-amber-400/80">Fallback — file date unavailable</span>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-ink">@log.DateCreatedUsed.Value.ToLocalTime().ToString("g")</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-faint">—</span>
                                    }
                                </td>
                                <td class="px-3 py-2">
                                    @if (!string.IsNullOrEmpty(log.ErrorMessage))
                                    {
                                        <button class="inline-flex cursor-pointer items-center gap-1 text-sm text-rose-600 hover:text-rose-500 dark:text-rose-400 dark:hover:text-rose-300"
                                                @onclick="@(() => ShowError(log.FileName, log.ErrorMessage!))">
                                            <Icon Name="error" Class="size-4" /> View Error
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="text-faint">—</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (ImportTotalPages > 1)
            {
                <div class="mt-3 flex items-center justify-end gap-2 text-sm text-muted">
                    <button class="icon-btn size-8" disabled="@(importPage == 1)" @onclick="@(() => importPage--)" title="Previous page">
                        <Icon Name="chevron-left" Class="size-4" />
                    </button>
                    <span>Page @importPage of @ImportTotalPages</span>
                    <button class="icon-btn size-8" disabled="@(importPage == ImportTotalPages)" @onclick="@(() => importPage++)" title="Next page">
                        <Icon Name="chevron-right" Class="size-4" />
                    </button>
                </div>
            }
        }
    </div>
}

else if (activeTab == 2)
{
    <!-- Transcription -->
    <div class="card">
        <div class="mb-4 flex flex-wrap items-center gap-2">
            <h2 class="flex-1 text-base font-semibold text-ink">Transcription Queue</h2>
            <button class="btn btn-ghost" @onclick="LoadTranscriptionData">
                <Icon Name="refresh" Class="size-4" /> Refresh
            </button>
        </div>

        <div class="mb-4 flex flex-wrap gap-2">
            <span class="badge badge-info">Pending: @TranscriptCount(TranscriptStatus.Pending)</span>
            <span class="badge badge-success">Completed: @TranscriptCount(TranscriptStatus.Completed)</span>
            <span class="badge badge-danger">Failed: @TranscriptCount(TranscriptStatus.Failed)</span>
            <span class="badge bg-surface-2 text-muted">Skipped: @TranscriptCount(TranscriptStatus.Skipped)</span>
            <span class="badge bg-surface-2 text-muted">Not requested: @TranscriptCount(TranscriptStatus.NotRequested)</span>
        </div>

        <div class="mb-5 flex flex-wrap gap-2">
            <button class="btn btn-primary" @onclick="RetryFailedTranscriptions"
                    disabled="@(TranscriptCount(TranscriptStatus.Failed) == 0)">
                <Icon Name="refresh" Class="size-4" /> Retry failed (@TranscriptCount(TranscriptStatus.Failed))
            </button>
            <button class="btn btn-ghost" @onclick="BackfillTranscriptions"
                    disabled="@(TranscriptCount(TranscriptStatus.NotRequested) == 0)">
                <Icon Name="microphone" Class="size-4" /> Transcribe back-catalog (@TranscriptCount(TranscriptStatus.NotRequested))
            </button>
        </div>

        <div class="mb-3 flex flex-wrap items-center gap-2">
            <span class="text-xs text-faint">Show:</span>
            @foreach (var filter in transcriptFilters)
            {
                var active = transcriptFilter == filter.Key;
                <button class="@($"chip {(active ? "chip-active" : "chip-inactive")}")"
                        @onclick="@(() => SetTranscriptFilter(filter.Key))">
                    @filter.Label
                </button>
            }
        </div>

        @if (transcriptVideos.Count == 0)
        {
            <p class="text-sm text-faint">No videos in this view.</p>
        }
        else
        {
            <div class="overflow-x-auto rounded-lg border border-line">
                <table class="w-full text-left text-sm">
                    <thead class="bg-surface-2 text-xs uppercase tracking-wide text-muted">
                        <tr>
                            <th class="px-3 py-2 font-medium">Video</th>
                            <th class="px-3 py-2 font-medium">Status</th>
                            <th class="px-3 py-2 font-medium">Confidence</th>
                            <th class="px-3 py-2 font-medium">Retries</th>
                            <th class="px-3 py-2 font-medium">Last Attempt</th>
                            <th class="px-3 py-2 font-medium">Error</th>
                            <th class="px-3 py-2 text-right font-medium">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-line">
                        @foreach (var row in PagedTranscriptRows)
                        {
                            <tr class="align-top hover:bg-surface-2">
                                <td class="px-3 py-2">
                                    <div class="font-medium text-ink">@(string.IsNullOrWhiteSpace(row.Creator) ? "—" : row.Creator)</div>
                                    <div class="line-clamp-1 max-w-xs text-xs text-muted">@row.Description</div>
                                    <div class="text-[11px] text-faint">@row.VideoId</div>
                                </td>
                                <td class="px-3 py-2">
                                    @{
                                        var badge = TranscriptBadge(row.Status);
                                    }
                                    <span class="badge @badge.Class">@badge.Label</span>
                                </td>
                                <td class="px-3 py-2">
                                    @if (row.Confidence.HasValue)
                                    {
                                        if (row.Confidence.Value < TranscriptionSvc.LowConfidenceThreshold)
                                        {
                                            <span class="inline-flex items-center gap-1 text-amber-600 dark:text-amber-400" title="Low confidence">
                                                <Icon Name="warning" Class="size-4" /> @row.Confidence.Value.ToString("P0")
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">@row.Confidence.Value.ToString("P0")</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-faint">—</span>
                                    }
                                </td>
                                <td class="px-3 py-2 text-ink">@row.RetryCount</td>
                                <td class="whitespace-nowrap px-3 py-2 text-muted">@(row.LastAttempt?.ToLocalTime().ToString("g") ?? "—")</td>
                                <td class="px-3 py-2">
                                    @if (!string.IsNullOrEmpty(row.Error))
                                    {
                                        <button class="inline-flex cursor-pointer items-center gap-1 text-sm text-rose-600 hover:text-rose-500 dark:text-rose-400 dark:hover:text-rose-300"
                                                @onclick="@(() => ShowTranscriptError(row.VideoId, row.Error!))">
                                            <Icon Name="error" Class="size-4" /> View
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="text-faint">—</span>
                                    }
                                </td>
                                <td class="px-3 py-2 text-right">
                                    <div class="flex items-center justify-end gap-3">
                                        @if (row.Status == TranscriptStatus.Completed)
                                        {
                                            <button class="inline-flex items-center gap-1 text-sm text-rose-600 hover:text-rose-500 dark:text-rose-400 dark:hover:text-rose-300"
                                                    @onclick="@(() => DeleteTranscript(row.VideoId))" title="Delete transcript">
                                                <Icon Name="trash" Class="size-4" /> Delete
                                            </button>
                                        }
                                        <button class="inline-flex items-center gap-1 text-sm text-sky-600 hover:text-sky-500 dark:text-sky-400 dark:hover:text-sky-300"
                                                @onclick="@(() => QueueTranscription(row.VideoId))"
                                                title="@(row.Status == TranscriptStatus.Completed ? "Re-transcribe" : "Queue transcription")">
                                            <Icon Name="refresh" Class="size-4" />
                                            @(row.Status == TranscriptStatus.Completed ? "Re-queue" : "Queue")
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (TranscriptTotalPages > 1)
            {
                <div class="mt-3 flex items-center justify-end gap-2 text-sm text-muted">
                    <button class="icon-btn size-8" disabled="@(transcriptPage == 1)" @onclick="@(() => transcriptPage--)" title="Previous page">
                        <Icon Name="chevron-left" Class="size-4" />
                    </button>
                    <span>Page @transcriptPage of @TranscriptTotalPages</span>
                    <button class="icon-btn size-8" disabled="@(transcriptPage == TranscriptTotalPages)" @onclick="@(() => transcriptPage++)" title="Next page">
                        <Icon Name="chevron-right" Class="size-4" />
                    </button>
                </div>
            }
        }
    </div>
}

@if (showErrorDialog)
{
    <ImportErrorDialog Title="@errorDialogTitle"
                       ErrorMessage="@errorDialogMessage"
                       OnClose="@(() => showErrorDialog = false)" />
}

@code {
    private int activeTab = 0;

    private int syncIntervalMinutes = 30;
    private DateTime? configLastModified;
    private bool isSavingConfig = false;

    private ReindexStatus reindexStatus = new();
    private System.Timers.Timer? reindexPollTimer;

    private int pendingCount = 0;
    private int retryingCount = 0;
    private List<ErrorItem> recentErrors = new();

    // Local Import
    private List<LocalImportLog> localImportLogs = new();
    private int localImportSuccessCount = 0;
    private int localImportFailedCount = 0;
    private int importPage = 1;
    private const int importPageSize = 25;

    // Transcription
    private static readonly (string Key, string Label)[] transcriptFilters =
    {
        ("queue", "Queue"),                 // active queue: Pending + Failed
        ("pending", "Pending"),
        ("failed", "Failed"),
        ("completed", "Completed"),
        ("lowconf", "Low confidence"),
        ("skipped", "Skipped"),
        ("notrequested", "Not requested"),
    };
    private Dictionary<TranscriptStatus, int> transcriptCounts = new();
    private string transcriptFilter = "queue";
    private List<TranscriptRow> transcriptVideos = new();
    private int transcriptPage = 1;
    private const int transcriptPageSize = 25;

    // Error dialog state (replaces MudBlazor's IDialogService)
    private bool showErrorDialog = false;
    private string errorDialogTitle = string.Empty;
    private string errorDialogMessage = string.Empty;

    private int TranscriptCount(TranscriptStatus status) =>
        transcriptCounts.TryGetValue(status, out var c) ? c : 0;

    private int TranscriptTotalPages => (int)Math.Ceiling(transcriptVideos.Count / (double)transcriptPageSize);

    private IEnumerable<TranscriptRow> PagedTranscriptRows =>
        transcriptVideos.Skip((transcriptPage - 1) * transcriptPageSize).Take(transcriptPageSize);

    private static (string Class, string Label) TranscriptBadge(TranscriptStatus status) => status switch
    {
        TranscriptStatus.Pending => ("badge-info", "Pending"),
        TranscriptStatus.Completed => ("badge-success", "Completed"),
        TranscriptStatus.Failed => ("badge-danger", "Failed"),
        TranscriptStatus.Skipped => ("bg-surface-2 text-muted", "Skipped"),
        TranscriptStatus.NotRequested => ("bg-surface-2 text-muted", "Not requested"),
        _ => ("bg-surface-2 text-muted", status.ToString())
    };

    private double ReindexPercentage => reindexStatus.TotalCount > 0
        ? reindexStatus.ProcessedCount * 100.0 / reindexStatus.TotalCount
        : 0;

    private int ImportTotalPages => (int)Math.Ceiling(localImportLogs.Count / (double)importPageSize);

    private IEnumerable<LocalImportLog> PagedImportLogs =>
        localImportLogs.Skip((importPage - 1) * importPageSize).Take(importPageSize);

    private string TabClass(int index) => index == activeTab
        ? "cursor-pointer border-b-2 border-sky-500 px-4 py-2 text-sm font-medium text-ink"
        : "cursor-pointer border-b-2 border-transparent px-4 py-2 text-sm font-medium text-muted hover:text-ink";

    protected override async Task OnInitializedAsync()
    {
        reindexStatus = ReindexCoordinator.Status;
        if (reindexStatus.IsRunning)
        {
            StartReindexPolling();
        }

        await LoadConfiguration();
        await LoadQueueStatus();
        await LoadLocalImportLog();
        await LoadTranscriptionData();
    }

    private async Task LoadConfiguration()
    {
        try
        {
            var config = await DbContext.SearchIndexConfigurations.FirstOrDefaultAsync();
            if (config != null)
            {
                syncIntervalMinutes = config.SyncIntervalMinutes;
                configLastModified = config.LastModified;
            }
        }
        catch (Exception ex)
        {
            Toast.Show($"Error loading configuration: {ex.Message}", ToastSeverity.Error);
        }
    }

    private async Task SaveConfiguration()
    {
        isSavingConfig = true;
        try
        {
            var config = await DbContext.SearchIndexConfigurations.FirstOrDefaultAsync();
            if (config == null)
            {
                config = new SearchIndexConfiguration
                {
                    SyncIntervalMinutes = syncIntervalMinutes
                };
                DbContext.SearchIndexConfigurations.Add(config);
            }
            else
            {
                config.SyncIntervalMinutes = syncIntervalMinutes;
            }

            await DbContext.SaveChangesAsync();
            Toast.Show("Configuration saved successfully", ToastSeverity.Success);
            await LoadConfiguration();
        }
        catch (Exception ex)
        {
            Toast.Show($"Error saving configuration: {ex.Message}", ToastSeverity.Error);
        }
        finally
        {
            isSavingConfig = false;
        }
    }

    private void StartReindex()
    {
        if (!ReindexCoordinator.TryStart())
        {
            Toast.Show("A reindex is already running", ToastSeverity.Warning);
        }

        reindexStatus = ReindexCoordinator.Status;
        StartReindexPolling();
    }

    private void StartReindexPolling()
    {
        if (reindexPollTimer != null) return;

        reindexPollTimer = new System.Timers.Timer(1000);
        reindexPollTimer.Elapsed += async (sender, args) => await InvokeAsync(RefreshReindexStatusAsync);
        reindexPollTimer.Start();
    }

    private async Task RefreshReindexStatusAsync()
    {
        var previous = reindexStatus;
        reindexStatus = ReindexCoordinator.Status;

        if (previous.IsRunning && !reindexStatus.IsRunning)
        {
            reindexPollTimer?.Stop();
            reindexPollTimer?.Dispose();
            reindexPollTimer = null;

            if (string.IsNullOrEmpty(reindexStatus.ErrorMessage))
            {
                Toast.Show("Reindex completed successfully", ToastSeverity.Success);
            }
            else
            {
                Toast.Show($"Reindex failed: {reindexStatus.ErrorMessage}", ToastSeverity.Error);
            }

            await LoadQueueStatus();
        }

        StateHasChanged();
    }

    private async Task LoadQueueStatus()
    {
        try
        {
            pendingCount = await DbContext.SearchIndexOperations.CountAsync();
            retryingCount = await DbContext.SearchIndexOperations.CountAsync(o => o.RetryCount > 0);
            recentErrors = await DbContext.SearchIndexOperations
                .Where(o => o.RetryCount > 0)
                .OrderByDescending(o => o.LastAttempt)
                .Take(10)
                .Select(o => new ErrorItem
                {
                    VideoId = o.VideoId,
                    OperationType = o.OperationType.ToString(),
                    RetryCount = o.RetryCount,
                    LastAttempt = o.LastAttempt,
                    ErrorMessage = o.ErrorMessage
                })
                .ToListAsync();
        }
        catch (Exception ex)
        {
            Toast.Show($"Error loading queue status: {ex.Message}", ToastSeverity.Error);
        }
    }

    private async Task LoadLocalImportLog()
    {
        try
        {
            localImportLogs = await DbContext.LocalImportLogs
                .OrderByDescending(l => l.ImportedAt)
                .Take(200)
                .ToListAsync();
            localImportSuccessCount = localImportLogs.Count(l => l.Status == LocalImportStatus.Success);
            localImportFailedCount  = localImportLogs.Count(l => l.Status == LocalImportStatus.Failed);
            importPage = 1;
        }
        catch (Exception ex)
        {
            Toast.Show($"Error loading import log: {ex.Message}", ToastSeverity.Error);
        }
    }

    private void ShowError(string fileName, string errorMessage)
    {
        errorDialogTitle = $"Import Error — {fileName}";
        errorDialogMessage = errorMessage;
        showErrorDialog = true;
    }

    private async Task LoadTranscriptionData()
    {
        try
        {
            transcriptCounts = await TranscriptionSvc.GetStatusCountsAsync();

            var threshold = TranscriptionSvc.LowConfidenceThreshold;
            var query = transcriptFilter switch
            {
                "pending" => DbContext.Videos.Where(v => v.TranscriptStatus == TranscriptStatus.Pending),
                "failed" => DbContext.Videos.Where(v => v.TranscriptStatus == TranscriptStatus.Failed),
                "completed" => DbContext.Videos.Where(v => v.TranscriptStatus == TranscriptStatus.Completed),
                "lowconf" => DbContext.Videos.Where(v => v.TranscriptStatus == TranscriptStatus.Completed
                                                      && v.TranscriptConfidence != null
                                                      && v.TranscriptConfidence < threshold),
                "skipped" => DbContext.Videos.Where(v => v.TranscriptStatus == TranscriptStatus.Skipped),
                "notrequested" => DbContext.Videos.Where(v => v.TranscriptStatus == TranscriptStatus.NotRequested),
                _ => DbContext.Videos.Where(v => v.TranscriptStatus == TranscriptStatus.Pending
                                              || v.TranscriptStatus == TranscriptStatus.Failed),
            };

            transcriptVideos = await query
                .OrderByDescending(v => v.AddedToApp)
                .Take(200)
                .Select(v => new TranscriptRow
                {
                    VideoId = v.TikTokVideoId,
                    Creator = v.Creator.DisplayName,
                    Description = v.Description,
                    Status = v.TranscriptStatus,
                    Confidence = v.TranscriptConfidence,
                    RetryCount = v.TranscriptRetryCount,
                    LastAttempt = v.TranscriptLastAttempt,
                    Error = v.TranscriptErrorMessage
                })
                .ToListAsync();
            transcriptPage = 1;
        }
        catch (Exception ex)
        {
            Toast.Show($"Error loading transcription queue: {ex.Message}", ToastSeverity.Error);
        }
    }

    private async Task SetTranscriptFilter(string key)
    {
        transcriptFilter = key;
        await LoadTranscriptionData();
    }

    private async Task QueueTranscription(string videoId)
    {
        try
        {
            await TranscriptionSvc.QueueAsync(videoId);
            Toast.Show("Queued for transcription", ToastSeverity.Success);
            await LoadTranscriptionData();
        }
        catch (Exception ex)
        {
            Toast.Show($"Error queueing transcription: {ex.Message}", ToastSeverity.Error);
        }
    }

    private async Task DeleteTranscript(string videoId)
    {
        try
        {
            await TranscriptionSvc.DeleteTranscriptAsync(videoId);
            Toast.Show("Transcript deleted", ToastSeverity.Success);
            await LoadTranscriptionData();
        }
        catch (Exception ex)
        {
            Toast.Show($"Error deleting transcript: {ex.Message}", ToastSeverity.Error);
        }
    }

    private async Task RetryFailedTranscriptions()
    {
        try
        {
            var count = await TranscriptionSvc.RetryFailedAsync();
            Toast.Show($"Requeued {count} failed transcription(s)", ToastSeverity.Success);
            await LoadTranscriptionData();
        }
        catch (Exception ex)
        {
            Toast.Show($"Error retrying transcriptions: {ex.Message}", ToastSeverity.Error);
        }
    }

    private async Task BackfillTranscriptions()
    {
        try
        {
            var count = await TranscriptionSvc.BackfillAsync();
            Toast.Show($"Queued {count} video(s) for transcription", ToastSeverity.Success);
            await LoadTranscriptionData();
        }
        catch (Exception ex)
        {
            Toast.Show($"Error queueing back-catalog: {ex.Message}", ToastSeverity.Error);
        }
    }

    private void ShowTranscriptError(string videoId, string error)
    {
        errorDialogTitle = $"Transcription Error — {videoId}";
        errorDialogMessage = error;
        showErrorDialog = true;
    }

    public void Dispose()
    {
        reindexPollTimer?.Dispose();
    }

    private class ErrorItem
    {
        public string VideoId { get; set; } = string.Empty;
        public string OperationType { get; set; } = string.Empty;
        public int RetryCount { get; set; }
        public DateTime? LastAttempt { get; set; }
        public string? ErrorMessage { get; set; }
    }

    private class TranscriptRow
    {
        public string VideoId { get; set; } = string.Empty;
        public string Creator { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public TranscriptStatus Status { get; set; }
        public double? Confidence { get; set; }
        public int RetryCount { get; set; }
        public DateTime? LastAttempt { get; set; }
        public string? Error { get; set; }
    }
}
