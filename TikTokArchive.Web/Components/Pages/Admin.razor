    private async Task LoadAiEnrichmentData()
    {
        try
        {
            aiCounts = await AiEnrichmentSvc.GetStatusCountsAsync();
            aiProviderCounts = await AiEnrichmentSvc.GetProviderCountsAsync();
            aiUnknownProviderCount = await AiEnrichmentSvc.GetUnknownProviderCountAsync();
            geminiModelCounts = await AiEnrichmentSvc.GetModelCountsAsync(AiProvider.Gemini);

            var query = aiFilter switch
            {
                "pending" => DbContext.Videos.Where(v => v.AiSummaryStatus == AiSummaryStatus.Pending),
                "failed" => DbContext.Videos.Where(v => v.AiSummaryStatus == AiSummaryStatus.Failed),
                "completed" => DbContext.Videos.Where(v => v.AiSummaryStatus == AiSummaryStatus.Completed),
                "skipped" => DbContext.Videos.Where(v => v.AiSummaryStatus == AiSummaryStatus.Skipped),
                "notrequested" => DbContext.Videos.Where(v => v.AiSummaryStatus == AiSummaryStatus.NotRequested),
                _ => DbContext.Videos.Where(v => v.AiSummaryStatus == AiSummaryStatus.Pending
                                              || v.AiSummaryStatus == AiSummaryStatus.Failed),
            };

            aiVideos = await query
                .OrderByDescending(v => v.AddedToApp)
                .Take(200)
                .Select(v => new AiRow
                {
                    VideoId = v.TikTokVideoId,
                    Creator = v.Creator.DisplayName,
                    Description = v.Description,
                    Status = v.AiSummaryStatus,
                    Summary = v.Summary,
                    RetryCount = v.AiSummaryRetryCount,
                    LastAttempt = v.AiSummaryLastAttempt,
                    Error = v.AiSummaryErrorMessage,
                    Provider = v.AiSummaryProvider,
                    Model = v.AiSummaryModel
                })
                .ToListAsync();
            aiPage = 1;
        }
        catch (Exception ex)
        {
            Toast.Show($"Error loading AI enrichment queue: {ex.Message}", ToastSeverity.Error);
        }
    }

    // Wraps the (usually instant) reload so the button gives visible feedback: the icon spins
    // for at least a second — long enough to register the click and confirm a refresh happened —
    // while the data loads concurrently. A toast confirms completion.
