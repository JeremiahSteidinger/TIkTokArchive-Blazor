    private int TranscriptTotalPages => (int)Math.Ceiling(transcriptVideos.Count / (double)transcriptPageSize);

    private IEnumerable<TranscriptRow> PagedTranscriptRows =>
        transcriptVideos.Skip((transcriptPage - 1) * transcriptPageSize).Take(transcriptPageSize);

    private static (string Class, string Label) TranscriptBadge(TranscriptStatus status) => status switch
    {
        TranscriptStatus.Pending => ("badge-info", "Pending"),
        TranscriptStatus.Completed => ("badge-success", "Completed"),
        TranscriptStatus.Failed => ("badge-danger", "Failed"),
        TranscriptStatus.Skipped => ("bg-surface-2 text-muted", "Skipped"),
        TranscriptStatus.NotRequested => ("bg-surface-2 text-muted", "Not requested"),
        _ => ("bg-surface-2 text-muted", status.ToString())
    };

    private int AiCount(AiSummaryStatus status) =>
        aiCounts.TryGetValue(status, out var c) ? c : 0;

    private int AiTotalPages => (int)Math.Ceiling(aiVideos.Count / (double)aiPageSize);

    private IEnumerable<AiRow> PagedAiRows =>
        aiVideos.Skip((aiPage - 1) * aiPageSize).Take(aiPageSize);

    private static (string Class, string Label) AiBadge(AiSummaryStatus status) => status switch
    {
        AiSummaryStatus.Pending => ("badge-info", "Pending"),
        AiSummaryStatus.Completed => ("badge-success", "Completed"),
        AiSummaryStatus.Failed => ("badge-danger", "Failed"),
        AiSummaryStatus.Skipped => ("bg-surface-2 text-muted", "Skipped"),
        AiSummaryStatus.NotRequested => ("bg-surface-2 text-muted", "Not requested"),
        _ => ("bg-surface-2 text-muted", status.ToString())
    };

    private double ReindexPercentage => reindexStatus.TotalCount > 0
        ? reindexStatus.ProcessedCount * 100.0 / reindexStatus.TotalCount
        : 0;

    private int ImportTotalPages => (int)Math.Ceiling(localImportLogs.Count / (double)importPageSize);

    private IEnumerable<LocalImportLog> PagedImportLogs =>
        localImportLogs.Skip((importPage - 1) * importPageSize).Take(importPageSize);

    private string TabClass(int index) => index == activeTab
        ? "cursor-pointer border-b-2 border-sky-500 px-4 py-2 text-sm font-medium text-ink"
        : "cursor-pointer border-b-2 border-transparent px-4 py-2 text-sm font-medium text-muted hover:text-ink";

    protected override async Task OnInitializedAsync()
    {
        reindexStatus = ReindexCoordinator.Status;
        if (reindexStatus.IsRunning)
        {
            StartReindexPolling();
        }

        await LoadConfiguration();
        await LoadQueueStatus();
        await LoadIndices();
        await LoadLocalImportLog();
        await LoadTranscriptionData();
        await LoadAiEnrichmentData();
        await LoadAiProviderSettings();
    }

    private async Task LoadAiProviderSettings()
    {
        try
        {
            var settings = await DbContext.AiProviderSettings.FirstOrDefaultAsync();
            aiProvider = settings?.Provider ?? AiProvider.Local;
            geminiApiKeyConfigured = !string.IsNullOrWhiteSpace(settings?.GeminiApiKey);
            selectedGeminiModel = settings?.GeminiModel;
            aiProviderLastModified = settings?.LastModified;
            // Always shown in full (unlike the API key) — either the saved override, or the
            // generated default so the admin can see exactly what's being sent and tweak from there.
            systemPromptInput = string.IsNullOrWhiteSpace(settings?.SystemPrompt)
                ? AiSummaryPromptHelper.BuildSystemPrompt(AiEnrichmentOptionsAccessor.Value)
                : settings.SystemPrompt;
        }
        catch (Exception ex)
        {
            Toast.Show($"Error loading AI provider settings: {ex.Message}", ToastSeverity.Error);
        }
    }

    private void ResetSystemPromptToDefault()
    {
        systemPromptInput = AiSummaryPromptHelper.BuildSystemPrompt(AiEnrichmentOptionsAccessor.Value);
    }

    // Uses the freshly typed key when there is one, otherwise the saved key — read straight from
    // the DB server-side (Blazor Server keeps @code on the server, so this never reaches the browser).
    private async Task<string?> ResolveGeminiApiKeyAsync()
    {
        if (!string.IsNullOrWhiteSpace(geminiApiKeyInput))
        {
            return geminiApiKeyInput.Trim();
        }

        var settings = await DbContext.AiProviderSettings.FirstOrDefaultAsync();
        return settings?.GeminiApiKey;
    }

    private async Task FetchGeminiModels()
    {
        var apiKey = await ResolveGeminiApiKeyAsync();
        if (string.IsNullOrWhiteSpace(apiKey))
        {
            Toast.Show("Enter a Gemini API key first", ToastSeverity.Warning);
            return;
        }

        isFetchingGeminiModels = true;
        try
        {
            geminiModels = (await GeminiModelCatalog.ListModelsAsync(apiKey)).ToList();
            if (geminiModels.Count == 0)
            {
                Toast.Show("No usable Gemini models were returned for this key", ToastSeverity.Warning);
            }
            else
            {
                Toast.Show($"Found {geminiModels.Count} model(s)", ToastSeverity.Success);
                if (selectedGeminiModel == null || geminiModels.All(m => m.Id != selectedGeminiModel))
                {
                    selectedGeminiModel = geminiModels[0].Id;
                }
            }
        }
        catch (Exception ex)
        {
            Toast.Show($"Error fetching Gemini models: {ex.Message}", ToastSeverity.Error);
        }
        finally
        {
            isFetchingGeminiModels = false;
        }
    }

    private async Task SaveAiProviderSettings()
    {
        if (aiProvider == AiProvider.Gemini && !geminiApiKeyConfigured && string.IsNullOrWhiteSpace(geminiApiKeyInput))
        {
            Toast.Show("Enter a Gemini API key before switching to Gemini", ToastSeverity.Warning);
            return;
        }

        isSavingAiProvider = true;
        try
        {
            var settings = await DbContext.AiProviderSettings.FirstOrDefaultAsync();
            if (settings == null)
            {
                settings = new AiProviderSettings();
                DbContext.AiProviderSettings.Add(settings);
            }

            settings.Provider = aiProvider;
            if (!string.IsNullOrWhiteSpace(geminiApiKeyInput))
            {
                settings.GeminiApiKey = geminiApiKeyInput.Trim();
            }
            settings.GeminiModel = string.IsNullOrWhiteSpace(selectedGeminiModel) ? null : selectedGeminiModel;

            // A blank textarea means "use the generated default", not "send an empty prompt".
            var defaultPrompt = AiSummaryPromptHelper.BuildSystemPrompt(AiEnrichmentOptionsAccessor.Value);
            settings.SystemPrompt = string.IsNullOrWhiteSpace(systemPromptInput) || systemPromptInput.Trim() == defaultPrompt
                ? null
                : systemPromptInput.Trim();

            await DbContext.SaveChangesAsync();
            geminiApiKeyInput = string.Empty;
            Toast.Show("AI provider settings saved", ToastSeverity.Success);
            await LoadAiProviderSettings();
        }
        catch (Exception ex)
        {
            Toast.Show($"Error saving AI provider settings: {ex.Message}", ToastSeverity.Error);
        }
        finally
        {
            isSavingAiProvider = false;
        }
    }

    private async Task LoadConfiguration()
    {
        try
        {
            var config = await DbContext.SearchIndexConfigurations.FirstOrDefaultAsync();
            if (config != null)
            {
                syncIntervalMinutes = config.SyncIntervalMinutes;
                configLastModified = config.LastModified;
            }
        }
        catch (Exception ex)
        {
            Toast.Show($"Error loading configuration: {ex.Message}", ToastSeverity.Error);
        }
    }

    private async Task SaveConfiguration()
    {
        isSavingConfig = true;
        try
        {
            var config = await DbContext.SearchIndexConfigurations.FirstOrDefaultAsync();
            if (config == null)
            {
                config = new SearchIndexConfiguration
                {
                    SyncIntervalMinutes = syncIntervalMinutes
                };
                DbContext.SearchIndexConfigurations.Add(config);
            }
            else
            {
                config.SyncIntervalMinutes = syncIntervalMinutes;
            }

            await DbContext.SaveChangesAsync();
            Toast.Show("Configuration saved successfully", ToastSeverity.Success);
            await LoadConfiguration();
        }
        catch (Exception ex)
        {
            Toast.Show($"Error saving configuration: {ex.Message}", ToastSeverity.Error);
        }
        finally
        {
            isSavingConfig = false;
        }
    }

    private void StartReindex()
    {
        if (!ReindexCoordinator.TryStart())
        {
            Toast.Show("A reindex is already running", ToastSeverity.Warning);
        }

        reindexStatus = ReindexCoordinator.Status;
        StartReindexPolling();
    }

    private void StartReindexPolling()
    {
        if (reindexPollTimer != null) return;

        reindexPollTimer = new System.Timers.Timer(1000);
        reindexPollTimer.Elapsed += async (sender, args) => await InvokeAsync(RefreshReindexStatusAsync);
        reindexPollTimer.Start();
    }

    private async Task RefreshReindexStatusAsync()
    {
        var previous = reindexStatus;
        reindexStatus = ReindexCoordinator.Status;

        if (previous.IsRunning && !reindexStatus.IsRunning)
        {
            reindexPollTimer?.Stop();
            reindexPollTimer?.Dispose();
            reindexPollTimer = null;

            if (string.IsNullOrEmpty(reindexStatus.ErrorMessage))
            {
                Toast.Show("Reindex completed successfully", ToastSeverity.Success);
            }
            else
            {
                Toast.Show($"Reindex failed: {reindexStatus.ErrorMessage}", ToastSeverity.Error);
            }

            await LoadQueueStatus();
        }

        StateHasChanged();
    }

    private async Task LoadQueueStatus()
    {
        try
        {
            pendingCount = await DbContext.SearchIndexOperations.CountAsync();
            retryingCount = await DbContext.SearchIndexOperations.CountAsync(o => o.RetryCount > 0);
            recentErrors = await DbContext.SearchIndexOperations
                .Where(o => o.RetryCount > 0)
                .OrderByDescending(o => o.LastAttempt)
                .Take(10)
                .Select(o => new ErrorItem
                {
                    VideoId = o.VideoId,
                    OperationType = o.OperationType.ToString(),
                    RetryCount = o.RetryCount,
                    LastAttempt = o.LastAttempt,
                    ErrorMessage = o.ErrorMessage
                })
                .ToListAsync();
        }
        catch (Exception ex)
        {
            Toast.Show($"Error loading queue status: {ex.Message}", ToastSeverity.Error);
        }
    }

    private async Task LoadIndices()
    {
        try
        {
            indices = await SearchService.GetIndicesAsync();
        }
        catch (Exception ex)
        {
            Toast.Show($"Error loading indices: {ex.Message}", ToastSeverity.Error);
        }
    }

    private void RequestDeleteIndex(SearchIndexInfo index) => indexPendingDelete = index;

    private async Task ConfirmDeleteIndex()
    {
        if (indexPendingDelete is null) return;

        var name = indexPendingDelete.Name;
        indexPendingDelete = null;
        try
        {
            await SearchService.DeleteIndexAsync(name);
            Toast.Show($"Deleted index {name}", ToastSeverity.Success);
            await LoadIndices();
        }
        catch (Exception ex)
        {
            Toast.Show($"Error deleting index {name}: {ex.Message}", ToastSeverity.Error);
        }
    }

    private static string HealthBadge(string health) => health switch
    {
        "green" => "badge-success",
        "yellow" => "bg-amber-100 text-amber-700 dark:bg-amber-500/15 dark:text-amber-300",
        "red" => "badge-danger",
        _ => "bg-surface-2 text-muted"
    };

    private async Task LoadLocalImportLog()
    {
        try
        {
            localImportLogs = await DbContext.LocalImportLogs
                .OrderByDescending(l => l.ImportedAt)
                .Take(200)
                .ToListAsync();
            localImportSuccessCount = localImportLogs.Count(l => l.Status == LocalImportStatus.Success);
            localImportFailedCount  = localImportLogs.Count(l => l.Status == LocalImportStatus.Failed);
            importPage = 1;
        }
        catch (Exception ex)
        {
            Toast.Show($"Error loading import log: {ex.Message}", ToastSeverity.Error);
        }
    }

    // See RefreshAiEnrichmentData: spins the icon for at least a second so the (usually instant)
    // reload gives visible feedback, then confirms with a toast.
    private async Task RefreshLocalImportLog()
    {
        if (localImportRefreshing)
        {
            return;
        }

        localImportRefreshing = true;
        try
        {
            await Task.WhenAll(LoadLocalImportLog(), Task.Delay(1000));
        }
        finally
        {
            localImportRefreshing = false;
        }

        Toast.Show("Import log refreshed", ToastSeverity.Success);
    }

    private void ShowError(string fileName, string errorMessage)
    {
        errorDialogTitle = $"Import Error — {fileName}";
        errorDialogMessage = errorMessage;
        showErrorDialog = true;
    }

    private async Task LoadTranscriptionData()
    {
        try
        {
            transcriptCounts = await TranscriptionSvc.GetStatusCountsAsync();

            var threshold = TranscriptionSvc.LowConfidenceThreshold;
            var query = transcriptFilter switch
            {
                "pending" => DbContext.Videos.Where(v => v.TranscriptStatus == TranscriptStatus.Pending),
                "failed" => DbContext.Videos.Where(v => v.TranscriptStatus == TranscriptStatus.Failed),
                "completed" => DbContext.Videos.Where(v => v.TranscriptStatus == TranscriptStatus.Completed),
                "lowconf" => DbContext.Videos.Where(v => v.TranscriptStatus == TranscriptStatus.Completed
                                                      && v.TranscriptConfidence != null
                                                      && v.TranscriptConfidence < threshold),
                "skipped" => DbContext.Videos.Where(v => v.TranscriptStatus == TranscriptStatus.Skipped),
                "notrequested" => DbContext.Videos.Where(v => v.TranscriptStatus == TranscriptStatus.NotRequested),
                _ => DbContext.Videos.Where(v => v.TranscriptStatus == TranscriptStatus.Pending
                                              || v.TranscriptStatus == TranscriptStatus.Failed),
            };

            transcriptVideos = await query
                .OrderByDescending(v => v.AddedToApp)
                .Take(200)
                .Select(v => new TranscriptRow
                {
                    VideoId = v.TikTokVideoId,
                    Creator = v.Creator.DisplayName,
                    Description = v.Description,
                    Status = v.TranscriptStatus,
                    Confidence = v.TranscriptConfidence,
                    RetryCount = v.TranscriptRetryCount,
                    LastAttempt = v.TranscriptLastAttempt,
                    Error = v.TranscriptErrorMessage
                })
                .ToListAsync();
            transcriptPage = 1;
        }
        catch (Exception ex)
        {
            Toast.Show($"Error loading transcription queue: {ex.Message}", ToastSeverity.Error);
        }
    }

    // See RefreshAiEnrichmentData: spins the icon for at least a second so the (usually instant)
    // reload gives visible feedback, then confirms with a toast.
