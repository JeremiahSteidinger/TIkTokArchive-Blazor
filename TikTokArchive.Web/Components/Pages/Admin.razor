@page "/admin"
@using Microsoft.EntityFrameworkCore
@using TikTokArchive.Entities
@using TikTokArchive.Web.Services
@inject TikTokArchiveDbContext DbContext
@inject ISearchService SearchService
@inject HttpClient HttpClient
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject IConfiguration Configuration
@inject IDialogService DialogService

<PageTitle>Admin - Configuration</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Administration</MudText>

<MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-4">
    <MudTabPanel Text="Search Index">
        <MudGrid>
            <MudItem xs="12" md="6">
                <MudPaper Class="pa-4">
                    <MudText Typo="Typo.h6" Class="mb-3">Configuration</MudText>
                    
                    <MudNumericField @bind-Value="syncIntervalMinutes"
                                     Label="Sync Interval (minutes)"
                                     Min="1"
                                     Max="1440"
                                     Variant="Variant.Outlined"
                                     Class="mb-3" />
                    
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               OnClick="SaveConfiguration"
                               Disabled="isSavingConfig">
                        @if (isSavingConfig)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                        }
                        Save Configuration
                    </MudButton>
                    
                    @if (configLastModified.HasValue)
                    {
                        <MudText Typo="Typo.caption" Class="mt-2">
                            Last modified: @configLastModified.Value.ToLocalTime().ToString("g")
                        </MudText>
                    }
                </MudPaper>
            </MudItem>
            
            <MudItem xs="12" md="6">
                <MudPaper Class="pa-4">
                    <MudText Typo="Typo.h6" Class="mb-3">Bulk Reindex</MudText>
                    
                    <MudText Typo="Typo.body2" Class="mb-3">
                        Rebuild the entire search index from the database. This may take several minutes.
                    </MudText>
                    
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Secondary"
                               OnClick="StartReindex"
                               Disabled="isReindexing">
                        @if (isReindexing)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                        }
                        Start Bulk Reindex
                    </MudButton>
                    
                    @if (isReindexing && reindexProgress != null)
                    {
                        <div class="mt-4">
                            <MudText Typo="Typo.body2" Class="mb-2">
                                Progress: @reindexProgress.ProcessedCount / @reindexProgress.TotalCount
                                (@reindexProgress.Percentage.ToString("F1")%)
                            </MudText>
                            <MudProgressLinear Color="Color.Primary" 
                                               Value="@reindexProgress.Percentage" 
                                               Size="Size.Large" />
                        </div>
                    }
                    
                    @if (!string.IsNullOrEmpty(reindexErrorMessage))
                    {
                        <MudAlert Severity="Severity.Error" Class="mt-3">@reindexErrorMessage</MudAlert>
                    }
                    
                    @if (reindexCompletedAt.HasValue)
                    {
                        <MudAlert Severity="Severity.Success" Class="mt-3">
                            Reindex completed at @reindexCompletedAt.Value.ToLocalTime().ToString("g")
                        </MudAlert>
                    }
                </MudPaper>
            </MudItem>
            
            <MudItem xs="12">
                <MudPaper Class="pa-4">
                    <MudText Typo="Typo.h6" Class="mb-3">Queue Status</MudText>
                    
                    <MudStack Row="true" Spacing="4" Class="mb-3">
                        <MudChip T="string" Color="Color.Info">
                            Pending Operations: @pendingCount
                        </MudChip>
                        <MudChip T="string" Color="Color.Error">
                            Failed Operations: @failedCount
                        </MudChip>
                    </MudStack>
                    
                    @if (recentErrors.Any())
                    {
                        <MudText Typo="Typo.subtitle2" Class="mb-2">Recent Errors:</MudText>
                        <MudTable Items="@recentErrors" Dense="true" Hover="true">
                            <HeaderContent>
                                <MudTh>Video ID</MudTh>
                                <MudTh>Operation</MudTh>
                                <MudTh>Retry Count</MudTh>
                                <MudTh>Last Attempt</MudTh>
                                <MudTh>Error</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd>@context.VideoId</MudTd>
                                <MudTd>@context.OperationType</MudTd>
                                <MudTd>@context.RetryCount</MudTd>
                                <MudTd>@context.LastAttempt?.ToLocalTime().ToString("g")</MudTd>
                                <MudTd>
                                    <MudText Typo="Typo.caption">
                                        @(context.ErrorMessage?.Length > 50 
                                            ? context.ErrorMessage.Substring(0, 50) + "..." 
                                            : context.ErrorMessage)
                                    </MudText>
                                </MudTd>
                            </RowTemplate>
                        </MudTable>
                    }
                </MudPaper>
            </MudItem>
        </MudGrid>
    </MudTabPanel>
    
    <MudTabPanel Text="Transcription">
        @if (sttProvider != null)
        {
            <MudGrid>
                <MudItem xs="12" md="8">
                    <MudPaper Class="pa-4 mb-4">
                        <MudText Typo="Typo.h6" Class="mb-3">Transcription Configuration</MudText>
                        
                        <MudSelect T="string" @bind-Value="sttProvider" 
                                   Label="STT Provider" 
                                   Variant="Variant.Outlined" 
                                   Class="mb-3">
                            <MudSelectItem T="string" Value="@("None")">None (Disabled)</MudSelectItem>
                            <MudSelectItem T="string" Value="@("WhisperLocal")">Whisper Local</MudSelectItem>
                            <MudSelectItem T="string" Value="@("OpenAI")">OpenAI Whisper</MudSelectItem>
                            <MudSelectItem T="string" Value="@("Azure")">Azure Speech</MudSelectItem>
                        </MudSelect>
                    
                    @if (sttProvider == "WhisperLocal")
                    {
                        <MudTextField @bind-Value="whisperUrl" 
                                      Label="Whisper URL" 
                                      Variant="Variant.Outlined" 
                                      Class="mb-3"
                                      HelperText="e.g., http://localhost:9000" />
                        <MudTextField @bind-Value="whisperModel" 
                                      Label="Whisper Model" 
                                      Variant="Variant.Outlined" 
                                      Class="mb-3"
                                      HelperText="e.g., base, small, medium, large" />
                    }
                    else if (sttProvider == "OpenAI")
                    {
                        <MudTextField @bind-Value="openAiApiKey" 
                                      Label="OpenAI API Key" 
                                      Variant="Variant.Outlined" 
                                      InputType="InputType.Password"
                                      Class="mb-3"
                                      HelperText="Leave as *** to keep existing key" />
                    }
                    else if (sttProvider == "Azure")
                    {
                        <MudTextField @bind-Value="azureSpeechKey" 
                                      Label="Azure Speech Key" 
                                      Variant="Variant.Outlined" 
                                      InputType="InputType.Password"
                                      Class="mb-3"
                                      HelperText="Leave as *** to keep existing key" />
                        <MudTextField @bind-Value="azureSpeechRegion" 
                                      Label="Azure Speech Region" 
                                      Variant="Variant.Outlined" 
                                      Class="mb-3"
                                      HelperText="e.g., eastus, westus2" />
                    }
                    
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               OnClick="SaveTranscriptionConfig"
                               Disabled="isSavingTranscriptionConfig">
                        @if (isSavingTranscriptionConfig)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                        }
                        Save Transcription Configuration
                    </MudButton>
                    
                    @if (!string.IsNullOrEmpty(transcriptionConfigMessage))
                    {
                        <MudAlert Severity="Severity.Success" Class="mt-3">@transcriptionConfigMessage</MudAlert>
                    }
                </MudPaper>
            </MudItem>
            
            <MudItem xs="12" md="6">
                <MudPaper Class="pa-4">
                    <MudText Typo="Typo.h6" Class="mb-3">Statistics</MudText>
                    
                    <MudStack Spacing="2">
                        <MudText Typo="Typo.body2">
                            Total Videos: <strong>@totalVideos</strong>
                        </MudText>
                        <MudText Typo="Typo.body2">
                            Transcribed: <strong>@transcribedVideos</strong>
                        </MudText>
                        <MudText Typo="Typo.body2">
                            Pending: <strong>@pendingTranscriptions</strong>
                        </MudText>
                        <MudText Typo="Typo.body2">
                            Processing: <strong>@processingTranscriptions</strong>
                        </MudText>
                        <MudText Typo="Typo.body2">
                            Failed: <strong>@failedTranscriptions</strong>
                        </MudText>
                    </MudStack>
                </MudPaper>
            </MudItem>
            
            <MudItem xs="12" md="6">
                <MudPaper Class="pa-4">
                    <MudText Typo="Typo.h6" Class="mb-3">Batch Transcription</MudText>
                    
                    <MudText Typo="Typo.body2" Class="mb-3">
                        Queue all videos that don't have transcripts yet.
                    </MudText>
                    
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Secondary"
                               OnClick="StartBatchTranscription"
                               Disabled="!transcriptionEnabled || isQueueingBatch">
                        @if (isQueueingBatch)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                        }
                        Queue All Untranscribed Videos
                    </MudButton>
                    
                    @if (!string.IsNullOrEmpty(batchMessage))
                    {
                        <MudAlert Severity="Severity.Success" Class="mt-3">@batchMessage</MudAlert>
                    }
                </MudPaper>
            </MudItem>
            
            @if (transcriptionErrors.Any())
            {
                <MudItem xs="12">
                    <MudPaper Class="pa-4">
                        <MudText Typo="Typo.h6" Class="mb-3">Recent Transcription Errors</MudText>
                        
                        <MudTable Items="@transcriptionErrors" Dense="true" Hover="true">
                            <HeaderContent>
                                <MudTh>Video ID</MudTh>
                                <MudTh>Retry Count</MudTh>
                                <MudTh>Queued At</MudTh>
                                <MudTh>Error</MudTh>
                                <MudTh>Actions</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd>@context.VideoId</MudTd>
                                <MudTd>@context.RetryCount</MudTd>
                                <MudTd>@context.QueuedAt.ToLocalTime().ToString("g")</MudTd>
                                <MudTd>
                                    <MudText Typo="Typo.caption">
                                        @(context.ErrorMessage?.Length > 50 
                                            ? context.ErrorMessage.Substring(0, 50) + "..." 
                                            : context.ErrorMessage)
                                    </MudText>
                                </MudTd>
                                <MudTd>
                                    <MudButton Size="Size.Small"
                                               Variant="Variant.Text"
                                               Color="Color.Primary"
                                               OnClick="() => RetryTranscription(context.VideoId)"
                                               Disabled="!transcriptionEnabled">
                                        Retry
                                    </MudButton>
                                </MudTd>
                            </RowTemplate>
                        </MudTable>
                    </MudPaper>
                </MudItem>
            }
        </MudGrid>
        }
        else
        {
            <MudText>Loading transcription configuration...</MudText>
        }
    </MudTabPanel>

    <MudTabPanel Text="Local Import">
        <MudGrid>
            <MudItem xs="12">
                <MudPaper Class="pa-4">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
                        <MudText Typo="Typo.h6" Style="flex:1">Import Log</MudText>
                        <MudChip T="string" Color="Color.Success" Size="Size.Small">
                            Success: @localImportSuccessCount
                        </MudChip>
                        <MudChip T="string" Color="Color.Error" Size="Size.Small">
                            Failed: @localImportFailedCount
                        </MudChip>
                        <MudButton Variant="Variant.Text"
                                   StartIcon="@Icons.Material.Filled.Refresh"
                                   OnClick="LoadLocalImportLog">
                            Refresh
                        </MudButton>
                    </MudStack>

                    @if (localImportLogs.Count == 0)
                    {
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            No imports recorded yet. Drop video files into the drop folder to get started.
                        </MudText>
                    }
                    else
                    {
                        <MudTable Items="@localImportLogs" Dense="true" Hover="true" SortLabel="Sort By">
                            <HeaderContent>
                                <MudTh><MudTableSortLabel SortBy="new Func<LocalImportLog, object>(x => x.ImportedAt)">Imported At</MudTableSortLabel></MudTh>
                                <MudTh><MudTableSortLabel SortBy="new Func<LocalImportLog, object>(x => x.FileName)">File Name</MudTableSortLabel></MudTh>
                                <MudTh>Status</MudTh>
                                <MudTh>Video ID</MudTh>
                                <MudTh><MudTableSortLabel SortBy="new Func<LocalImportLog, object?>(x => x.DateCreatedUsed)">Date Created Used</MudTableSortLabel></MudTh>
                                <MudTh>Error</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd>@context.ImportedAt.ToLocalTime().ToString("g")</MudTd>
                                <MudTd>
                                    <MudText Typo="Typo.body2" Style="word-break:break-all">@context.FileName</MudText>
                                </MudTd>
                                <MudTd>
                                    @if (context.Status == LocalImportStatus.Success)
                                    {
                                        <MudChip T="string" Color="Color.Success" Size="Size.Small">Success</MudChip>
                                    }
                                    else
                                    {
                                        <MudChip T="string" Color="Color.Error" Size="Size.Small">Failed</MudChip>
                                    }
                                </MudTd>
                                <MudTd>
                                    <MudText Typo="Typo.caption">@(context.VideoId ?? "—")</MudText>
                                </MudTd>
                                <MudTd>
                                    @if (context.DateCreatedUsed.HasValue)
                                    {
                                        @if (context.DateCreatedUsed.Value.Year == 1970)
                                        {
                                            <MudStack Spacing="0">
                                                <MudText Typo="Typo.body2" Color="Color.Warning">
                                                    <MudIcon Icon="@Icons.Material.Filled.Warning" Size="Size.Small" Class="mr-1" />
                                                    @context.DateCreatedUsed.Value.ToLocalTime().ToString("g")
                                                </MudText>
                                                <MudText Typo="Typo.caption" Color="Color.Warning">Fallback — file date unavailable</MudText>
                                            </MudStack>
                                        }
                                        else
                                        {
                                            <MudText Typo="Typo.body2">@context.DateCreatedUsed.Value.ToLocalTime().ToString("g")</MudText>
                                        }
                                    }
                                    else
                                    {
                                        <MudText Typo="Typo.body2">—</MudText>
                                    }
                                </MudTd>
                                <MudTd>
                                    @if (!string.IsNullOrEmpty(context.ErrorMessage))
                                    {
                                        <MudButton Size="Size.Small"
                                                   Variant="Variant.Text"
                                                   Color="Color.Error"
                                                   StartIcon="@Icons.Material.Filled.ErrorOutline"
                                                   OnClick="() => ShowError(context.FileName, context.ErrorMessage!)">
                                            View Error
                                        </MudButton>
                                    }
                                    else
                                    {
                                        <MudText Typo="Typo.body2">—</MudText>
                                    }
                                </MudTd>
                            </RowTemplate>
                            <PagerContent>
                                <MudTablePager />
                            </PagerContent>
                        </MudTable>
                    }
                </MudPaper>
            </MudItem>
        </MudGrid>
    </MudTabPanel>
</MudTabs>

@code {
    // Search Index fields
    private int syncIntervalMinutes = 30;
    private DateTime? configLastModified;
    private bool isSavingConfig = false;
    
    private bool isReindexing = false;
    private string? reindexSessionId;
    private ReindexProgressData? reindexProgress;
    private string? reindexErrorMessage;
    private DateTime? reindexCompletedAt;
    
    private int pendingCount = 0;
    private int failedCount = 0;
    private List<ErrorItem> recentErrors = new();

    // Transcription fields
    private string sttProvider = "None";
    private bool transcriptionEnabled = false;
    private bool rabbitMQConnected = false;
    private int totalVideos = 0;
    private int transcribedVideos = 0;
    private int pendingTranscriptions = 0;
    private int processingTranscriptions = 0;
    private int failedTranscriptions = 0;
    private bool isQueueingBatch = false;
    private string? batchMessage;
    private List<TranscriptionErrorItem> transcriptionErrors = new();
    private bool isSavingTranscriptionConfig = false;
    private string? transcriptionConfigMessage;
    private string whisperUrl = "";
    private string whisperModel = "";
    private string openAiApiKey = "";
    private string azureSpeechKey = "";
    private string azureSpeechRegion = "";

    // Local Import fields
    private List<LocalImportLog> localImportLogs = new();
    private int localImportSuccessCount = 0;
    private int localImportFailedCount = 0;

    protected override async Task OnInitializedAsync()
    {
        await LoadConfiguration();
        await LoadQueueStatus();
        await LoadTranscriptionStatus();
        await LoadLocalImportLog();
    }

    private async Task LoadConfiguration()
    {
        try
        {
            var config = await DbContext.SearchIndexConfigurations.FirstOrDefaultAsync();
            if (config != null)
            {
                syncIntervalMinutes = config.SyncIntervalMinutes;
                configLastModified = config.LastModified;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading configuration: {ex.Message}", Severity.Error);
        }
    }

    private async Task SaveConfiguration()
    {
        isSavingConfig = true;
        try
        {
            var config = await DbContext.SearchIndexConfigurations.FirstOrDefaultAsync();
            if (config == null)
            {
                config = new SearchIndexConfiguration
                {
                    SyncIntervalMinutes = syncIntervalMinutes
                };
                DbContext.SearchIndexConfigurations.Add(config);
            }
            else
            {
                config.SyncIntervalMinutes = syncIntervalMinutes;
            }
            
            await DbContext.SaveChangesAsync();
            Snackbar.Add("Configuration saved successfully", Severity.Success);
            await LoadConfiguration();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error saving configuration: {ex.Message}", Severity.Error);
        }
        finally
        {
            isSavingConfig = false;
        }
    }

    private async Task StartReindex()
    {
        isReindexing = true;
        reindexErrorMessage = null;
        reindexCompletedAt = null;
        reindexSessionId = Guid.NewGuid().ToString();
        
        var totalVideosCount = await DbContext.Videos.CountAsync();
        reindexProgress = new ReindexProgressData
        {
            IsRunning = true,
            ProcessedCount = 0,
            TotalCount = totalVideosCount,
            Percentage = 0,
            StartedAt = DateTime.UtcNow
        };
        
        try
        {
            _ = Task.Run(async () =>
            {
                try
                {
                    var progress = new Progress<int>(processedCount =>
                    {
                        reindexProgress = new ReindexProgressData
                        {
                            IsRunning = true,
                            ProcessedCount = processedCount,
                            TotalCount = totalVideosCount,
                            Percentage = totalVideosCount > 0 ? (processedCount * 100.0 / totalVideosCount) : 0,
                            StartedAt = reindexProgress.StartedAt
                        };
                        InvokeAsync(StateHasChanged);
                    });
                    
                    await SearchService.BulkReindexAsync(progress, CancellationToken.None);
                    
                    reindexProgress = new ReindexProgressData
                    {
                        IsRunning = false,
                        ProcessedCount = totalVideosCount,
                        TotalCount = totalVideosCount,
                        Percentage = 100,
                        StartedAt = reindexProgress.StartedAt,
                        CompletedAt = DateTime.UtcNow
                    };
                    isReindexing = false;
                    reindexCompletedAt = DateTime.UtcNow;
                    await InvokeAsync(() =>
                    {
                        Snackbar.Add("Reindex completed successfully", Severity.Success);
                        StateHasChanged();
                    });
                }
                catch (Exception ex)
                {
                    reindexErrorMessage = ex.Message;
                    isReindexing = false;
                    await InvokeAsync(() =>
                    {
                        Snackbar.Add($"Reindex failed: {ex.Message}", Severity.Error);
                        StateHasChanged();
                    });
                }
            });
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error starting reindex: {ex.Message}", Severity.Error);
            isReindexing = false;
        }
    }

    private async Task LoadQueueStatus()
    {
        try
        {
            pendingCount = await DbContext.SearchIndexOperations.CountAsync();
            recentErrors = await DbContext.SearchIndexOperations
                .Where(o => o.RetryCount >= 3)
                .OrderByDescending(o => o.LastAttempt)
                .Take(10)
                .Select(o => new ErrorItem
                {
                    VideoId = o.VideoId,
                    OperationType = o.OperationType.ToString(),
                    RetryCount = o.RetryCount,
                    LastAttempt = o.LastAttempt,
                    ErrorMessage = o.ErrorMessage
                })
                .ToListAsync();
            failedCount = recentErrors.Count;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading queue status: {ex.Message}");
        }
    }

    private async Task LoadTranscriptionStatus()
    {
        try
        {
            // Load configuration
            try
            {
                var configResponse = await HttpClient.GetFromJsonAsync<TranscriptionConfigResponse>("/api/admin/transcription/config");
                if (configResponse != null)
                {
                    sttProvider = configResponse.SttProvider ?? "None";
                    whisperUrl = configResponse.WhisperUrl ?? "";
                    whisperModel = configResponse.WhisperModel ?? "";
                    openAiApiKey = configResponse.OpenAiApiKey ?? "";
                    azureSpeechKey = configResponse.AzureSpeechKey ?? "";
                    azureSpeechRegion = configResponse.AzureSpeechRegion ?? "";
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error loading transcription config: {ex.Message}");
                // Keep defaults
            }
            
            // Load status
            try
            {
                var response = await HttpClient.GetFromJsonAsync<TranscriptionStatusResponse>("/api/admin/transcription/status");
                if (response != null)
                {
                    transcriptionEnabled = response.IsEnabled;
                    rabbitMQConnected = response.RabbitMQConnected;
                    pendingTranscriptions = response.PendingCount;
                    processingTranscriptions = response.ProcessingCount;
                    failedTranscriptions = response.FailedCount;
                    transcriptionErrors = response.RecentFailures ?? new();
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error loading transcription status: {ex.Message}");
                // Keep defaults
            }
            
            try
            {
                totalVideos = await DbContext.Videos.CountAsync();
                transcribedVideos = await DbContext.VideoTranscripts.CountAsync();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error loading video counts: {ex.Message}");
                // Keep defaults
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error in LoadTranscriptionStatus: {ex.Message}");
            Snackbar.Add("Error loading transcription status. Some features may be unavailable.", Severity.Warning);
        }
    }
    
    private async Task SaveTranscriptionConfig()
    {
        isSavingTranscriptionConfig = true;
        transcriptionConfigMessage = null;
        
        try
        {
            var request = new
            {
                sttProvider,
                whisperUrl,
                whisperModel,
                openAiApiKey,
                azureSpeechKey,
                azureSpeechRegion
            };
            
            var response = await HttpClient.PostAsJsonAsync("/api/admin/transcription/config", request);
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<MessageResponse>();
                transcriptionConfigMessage = result?.Message ?? "Configuration saved successfully";
                Snackbar.Add(transcriptionConfigMessage, Severity.Success);
                await LoadTranscriptionStatus();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Error saving configuration: {error}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error saving configuration: {ex.Message}", Severity.Error);
        }
        finally
        {
            isSavingTranscriptionConfig = false;
        }
    }

    private async Task StartBatchTranscription()
    {
        isQueueingBatch = true;
        batchMessage = null;
        
        try
        {
            var response = await HttpClient.PostAsync("/api/admin/transcription/batch", null);
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<MessageResponse>();
                batchMessage = result?.Message;
                Snackbar.Add(batchMessage ?? "Batch transcription queued", Severity.Success);
                await LoadTranscriptionStatus();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Error queuing batch transcription: {error}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error queuing batch transcription: {ex.Message}", Severity.Error);
        }
        finally
        {
            isQueueingBatch = false;
        }
    }

    private async Task RetryTranscription(int videoId)
    {
        try
        {
            var response = await HttpClient.PostAsync($"/api/admin/transcription/retry/{videoId}", null);
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Transcription retry queued", Severity.Success);
                await LoadTranscriptionStatus();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Error retrying transcription: {error}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error retrying transcription: {ex.Message}", Severity.Error);
        }
    }

    private async Task LoadLocalImportLog()
    {
        try
        {
            localImportLogs = await DbContext.LocalImportLogs
                .OrderByDescending(l => l.ImportedAt)
                .Take(200)
                .ToListAsync();
            localImportSuccessCount = localImportLogs.Count(l => l.Status == LocalImportStatus.Success);
            localImportFailedCount  = localImportLogs.Count(l => l.Status == LocalImportStatus.Failed);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading import log: {ex.Message}", Severity.Error);
        }
    }

    private async Task ShowError(string fileName, string errorMessage)
    {
        var parameters = new DialogParameters
        {
            ["Title"]        = $"Import Error — {fileName}",
            ["ErrorMessage"] = errorMessage
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseButton = true };
        await DialogService.ShowAsync<TikTokArchive.Web.Components.Components.ImportErrorDialog>("Import Error", parameters, options);
    }

