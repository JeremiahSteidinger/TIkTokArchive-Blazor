@page "/admin"
@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.Options
@using TikTokArchive.Entities
@using TikTokArchive.Web.Options
@using TikTokArchive.Web.Services
@inject TikTokArchiveDbContext DbContext
@inject ReindexCoordinator ReindexCoordinator
@inject ITranscriptionService TranscriptionSvc
@inject IAiEnrichmentService AiEnrichmentSvc
@inject GeminiModelCatalogService GeminiModelCatalog
@inject IOptions<AiEnrichmentOptions> AiEnrichmentOptionsAccessor
@inject ISearchService SearchService
@inject ToastService Toast
@implements IDisposable

<PageTitle>Admin - Configuration</PageTitle>

<h1 class="mb-6 text-2xl font-bold text-ink">Administration</h1>

<div class="mb-5 flex gap-1 border-b border-line">
    <button class="@TabClass(0)" @onclick="@(() => activeTab = 0)">Search Index</button>
    <button class="@TabClass(1)" @onclick="@(() => activeTab = 1)">Local Import</button>
    <button class="@TabClass(2)" @onclick="@(() => activeTab = 2)">Transcription</button>
    <button class="@TabClass(3)" @onclick="@(() => activeTab = 3)">AI Enrichment</button>
</div>

@if (activeTab == 0)
{
    <div class="grid gap-4 lg:grid-cols-2">
        <!-- Configuration -->
        <div class="card">
            <h2 class="mb-4 text-base font-semibold text-ink">Configuration</h2>

            <label class="label" for="syncInterval">Sync Interval (minutes)</label>
            <input id="syncInterval" type="number" min="1" max="1440" class="input mb-4"
                   @bind="syncIntervalMinutes" />

            <button class="btn btn-primary" @onclick="SaveConfiguration" disabled="@isSavingConfig">
                @if (isSavingConfig)
                {
                    <span class="spinner size-4"></span>
                }
                Save Configuration
            </button>

            @if (configLastModified.HasValue)
            {
                <p class="mt-2 text-xs text-faint">
                    Last modified: @configLastModified.Value.ToLocalTime().ToString("g")
                </p>
            }
        </div>

        <!-- Bulk Reindex -->
        <div class="card">
            <h2 class="mb-4 text-base font-semibold text-ink">Bulk Reindex</h2>

            <p class="mb-4 text-sm text-muted">
                Rebuild the entire search index from the database. This may take several minutes.
            </p>

            <button class="btn btn-primary" @onclick="StartReindex" disabled="@reindexStatus.IsRunning">
                @if (reindexStatus.IsRunning)
                {
                    <span class="spinner size-4"></span>
                }
                Start Bulk Reindex
            </button>

            @if (reindexStatus.IsRunning)
            {
                <div class="mt-4">
                    <p class="mb-2 text-sm text-muted">
                        Progress: @reindexStatus.ProcessedCount / @reindexStatus.TotalCount
                        (@ReindexPercentage.ToString("F1")%)
                    </p>
                    <div class="h-2 w-full overflow-hidden rounded-full bg-surface-2">
                        <div class="h-full rounded-full bg-sky-500 transition-all"
                             style="@($"width:{(int)ReindexPercentage}%")"></div>
                    </div>
                </div>
            }

            @if (!string.IsNullOrEmpty(reindexStatus.ErrorMessage))
            {
                <div class="alert alert-danger mt-3 items-center">
                    <Icon Name="error" Class="size-5 shrink-0 text-rose-500" />
                    @reindexStatus.ErrorMessage
                </div>
            }
            else if (reindexStatus.CompletedAt.HasValue)
            {
                <div class="alert alert-success mt-3 items-center">
                    <Icon Name="success" Class="size-5 shrink-0 text-emerald-500" />
                    Reindex completed at @reindexStatus.CompletedAt.Value.ToLocalTime().ToString("g")
                </div>
            }
        </div>
    </div>

    <!-- Queue Status -->
    <div class="card mt-4">
        <h2 class="mb-4 text-base font-semibold text-ink">Queue Status</h2>

        <div class="mb-4 flex flex-wrap gap-2">
            <span class="badge badge-info">Pending Operations: @pendingCount</span>
            <span class="badge badge-danger">Retrying Operations: @retryingCount</span>
        </div>

        @if (recentErrors.Any())
        {
            <h3 class="mb-2 text-sm font-semibold text-muted">Recent Errors:</h3>
            <div class="overflow-x-auto rounded-lg border border-line">
                <table class="w-full text-left text-sm">
                    <thead class="bg-surface-2 text-xs uppercase tracking-wide text-muted">
                        <tr>
                            <th class="px-3 py-2 font-medium">Video ID</th>
                            <th class="px-3 py-2 font-medium">Operation</th>
                            <th class="px-3 py-2 font-medium">Retry Count</th>
                            <th class="px-3 py-2 font-medium">Last Attempt</th>
                            <th class="px-3 py-2 font-medium">Error</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-line">
                        @foreach (var error in recentErrors)
                        {
                            <tr class="hover:bg-surface-2">
                                <td class="px-3 py-2 text-ink">@error.VideoId</td>
                                <td class="px-3 py-2 text-ink">@error.OperationType</td>
                                <td class="px-3 py-2 text-ink">@error.RetryCount</td>
                                <td class="whitespace-nowrap px-3 py-2 text-muted">@error.LastAttempt?.ToLocalTime().ToString("g")</td>
                                <td class="px-3 py-2 text-muted">
                                    @(error.ErrorMessage?.Length > 50
                                        ? error.ErrorMessage.Substring(0, 50) + "..."
                                        : error.ErrorMessage)
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <!-- Search Indices -->
    <div class="card mt-4">
        <div class="mb-4 flex flex-wrap items-center gap-2">
            <h2 class="flex-1 text-base font-semibold text-ink">Search Indices</h2>
            <button class="btn btn-ghost" @onclick="LoadIndices">
                <Icon Name="refresh" Class="size-4" /> Refresh
            </button>
        </div>

        <p class="mb-4 text-sm text-muted">
            OpenSearch indices for this app. The <span class="font-medium text-ink">active</span>
            index is what search and indexing use now; older versions are safe to delete once the
            active one is fully populated.
        </p>

        @if (indices.Count == 0)
        {
            <p class="text-sm text-faint">No indices found.</p>
        }
        else
        {
            <div class="overflow-x-auto rounded-lg border border-line">
                <table class="w-full text-left text-sm">
                    <thead class="bg-surface-2 text-xs uppercase tracking-wide text-muted">
                        <tr>
                            <th class="px-3 py-2 font-medium">Index</th>
                            <th class="px-3 py-2 font-medium">Health</th>
                            <th class="px-3 py-2 text-right font-medium">Documents</th>
                            <th class="px-3 py-2 text-right font-medium">Size</th>
                            <th class="px-3 py-2 text-right font-medium">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-line">
                        @foreach (var index in indices)
                        {
                            <tr class="hover:bg-surface-2">
                                <td class="px-3 py-2">
                                    <span class="font-mono text-ink">@index.Name</span>
                                    @if (index.IsActive)
                                    {
                                        <span class="badge badge-info ml-2">Active</span>
                                    }
                                </td>
                                <td class="px-3 py-2">
                                    <span class="badge @HealthBadge(index.Health)">@index.Health</span>
                                </td>
                                <td class="px-3 py-2 text-right text-ink">@index.DocsCount.ToString("N0")</td>
                                <td class="whitespace-nowrap px-3 py-2 text-right text-muted">@index.StoreSize</td>
                                <td class="px-3 py-2 text-right">
                                    @if (index.IsActive)
                                    {
                                        <span class="text-xs text-faint">In use</span>
                                    }
                                    else
                                    {
                                        <button class="inline-flex items-center gap-1 text-sm text-rose-600 hover:text-rose-500 dark:text-rose-400 dark:hover:text-rose-300"
                                                @onclick="@(() => RequestDeleteIndex(index))" title="Delete index">
                                            <Icon Name="trash" Class="size-4" /> Delete
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
}
else if (activeTab == 1)
{
    <!-- Local Import -->
    <div class="card">
        <div class="mb-4 flex flex-wrap items-center gap-2">
            <h2 class="flex-1 text-base font-semibold text-ink">Import Log</h2>
            <span class="badge badge-success">Success: @localImportSuccessCount</span>
            <span class="badge badge-danger">Failed: @localImportFailedCount</span>
            <button class="btn btn-ghost" @onclick="RefreshLocalImportLog" disabled="@localImportRefreshing">
                <Icon Name="refresh" Class="@($"size-4 {(localImportRefreshing ? "animate-spin" : "")}")" />
                @(localImportRefreshing ? "Refreshing…" : "Refresh")
            </button>
        </div>

        @if (localImportLogs.Count == 0)
        {
            <p class="text-sm text-faint">
                No imports recorded yet. Drop video files into the drop folder to get started.
            </p>
        }
        else
        {
            <div class="overflow-x-auto rounded-lg border border-line">
                <table class="w-full text-left text-sm">
                    <thead class="bg-surface-2 text-xs uppercase tracking-wide text-muted">
                        <tr>
                            <th class="px-3 py-2 font-medium">Imported At</th>
                            <th class="px-3 py-2 font-medium">File Name</th>
                            <th class="px-3 py-2 font-medium">Status</th>
                            <th class="px-3 py-2 font-medium">Video ID</th>
                            <th class="px-3 py-2 font-medium">Date Created Used</th>
                            <th class="px-3 py-2 font-medium">Error</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-line">
                        @foreach (var log in PagedImportLogs)
                        {
                            <tr class="hover:bg-surface-2 align-top">
                                <td class="whitespace-nowrap px-3 py-2 text-ink">@log.ImportedAt.ToLocalTime().ToString("g")</td>
                                <td class="px-3 py-2"><span class="break-all text-ink">@log.FileName</span></td>
                                <td class="px-3 py-2">
                                    @if (log.Status == LocalImportStatus.Success)
                                    {
                                        <span class="badge badge-success">Success</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-danger">Failed</span>
                                    }
                                </td>
                                <td class="px-3 py-2 text-xs text-muted">@(log.VideoId ?? "—")</td>
                                <td class="px-3 py-2">
                                    @if (log.DateCreatedUsed.HasValue)
                                    {
                                        @if (log.DateCreatedUsed.Value.Year == 1970)
                                        {
                                            <div class="flex flex-col">
                                                <span class="flex items-center gap-1 text-amber-600 dark:text-amber-400">
                                                    <Icon Name="warning" Class="size-4" />
                                                    @log.DateCreatedUsed.Value.ToLocalTime().ToString("g")
                                                </span>
                                                <span class="text-xs text-amber-600/80 dark:text-amber-400/80">Fallback — file date unavailable</span>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-ink">@log.DateCreatedUsed.Value.ToLocalTime().ToString("g")</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-faint">—</span>
                                    }
                                </td>
                                <td class="px-3 py-2">
                                    @if (!string.IsNullOrEmpty(log.ErrorMessage))
                                    {
                                        <button class="inline-flex cursor-pointer items-center gap-1 text-sm text-rose-600 hover:text-rose-500 dark:text-rose-400 dark:hover:text-rose-300"
                                                @onclick="@(() => ShowError(log.FileName, log.ErrorMessage!))">
                                            <Icon Name="error" Class="size-4" /> View Error
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="text-faint">—</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (ImportTotalPages > 1)
            {
                <div class="mt-3 flex items-center justify-end gap-2 text-sm text-muted">
                    <button class="icon-btn size-8" disabled="@(importPage == 1)" @onclick="@(() => importPage--)" title="Previous page">
                        <Icon Name="chevron-left" Class="size-4" />
                    </button>
                    <span>Page @importPage of @ImportTotalPages</span>
                    <button class="icon-btn size-8" disabled="@(importPage == ImportTotalPages)" @onclick="@(() => importPage++)" title="Next page">
                        <Icon Name="chevron-right" Class="size-4" />
                    </button>
                </div>
            }
        }
    </div>
}

else if (activeTab == 2)
{
    <!-- Transcription -->
    <div class="card">
        <div class="mb-4 flex flex-wrap items-center gap-2">
            <h2 class="flex-1 text-base font-semibold text-ink">Transcription Queue</h2>
            <button class="btn btn-ghost" @onclick="RefreshTranscriptionData" disabled="@transcriptRefreshing">
                <Icon Name="refresh" Class="@($"size-4 {(transcriptRefreshing ? "animate-spin" : "")}")" />
                @(transcriptRefreshing ? "Refreshing…" : "Refresh")
            </button>
        </div>

        <div class="mb-4 flex flex-wrap gap-2">
            <span class="badge badge-info">Pending: @TranscriptCount(TranscriptStatus.Pending)</span>
            <span class="badge badge-success">Completed: @TranscriptCount(TranscriptStatus.Completed)</span>
            <span class="badge badge-danger">Failed: @TranscriptCount(TranscriptStatus.Failed)</span>
            <span class="badge bg-surface-2 text-muted">Skipped: @TranscriptCount(TranscriptStatus.Skipped)</span>
            <span class="badge bg-surface-2 text-muted">Not requested: @TranscriptCount(TranscriptStatus.NotRequested)</span>
        </div>

        <div class="mb-5 flex flex-wrap gap-2">
            <button class="btn btn-primary" @onclick="RetryFailedTranscriptions"
                    disabled="@(TranscriptCount(TranscriptStatus.Failed) == 0)">
                <Icon Name="refresh" Class="size-4" /> Retry failed (@TranscriptCount(TranscriptStatus.Failed))
            </button>
            <button class="btn btn-ghost" @onclick="BackfillTranscriptions"
                    disabled="@(TranscriptCount(TranscriptStatus.NotRequested) == 0)">
                <Icon Name="microphone" Class="size-4" /> Transcribe back-catalog (@TranscriptCount(TranscriptStatus.NotRequested))
            </button>
        </div>

        <div class="mb-3 flex flex-wrap items-center gap-2">
            <span class="text-xs text-faint">Show:</span>
            @foreach (var filter in transcriptFilters)
            {
                var active = transcriptFilter == filter.Key;
                <button class="@($"chip {(active ? "chip-active" : "chip-inactive")}")"
                        @onclick="@(() => SetTranscriptFilter(filter.Key))">
                    @filter.Label
                </button>
            }
        </div>

        @if (transcriptVideos.Count == 0)
        {
            <p class="text-sm text-faint">No videos in this view.</p>
        }
        else
        {
            <div class="overflow-x-auto rounded-lg border border-line">
                <table class="w-full text-left text-sm">
                    <thead class="bg-surface-2 text-xs uppercase tracking-wide text-muted">
                        <tr>
                            <th class="px-3 py-2 font-medium">Video</th>
                            <th class="px-3 py-2 font-medium">Status</th>
                            <th class="px-3 py-2 font-medium">Confidence</th>
                            <th class="px-3 py-2 font-medium">Retries</th>
                            <th class="px-3 py-2 font-medium">Last Attempt</th>
                            <th class="px-3 py-2 font-medium">Error</th>
                            <th class="px-3 py-2 text-right font-medium">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-line">
                        @foreach (var row in PagedTranscriptRows)
                        {
                            <tr class="align-top hover:bg-surface-2">
                                <td class="px-3 py-2">
                                    <div class="font-medium text-ink">@(string.IsNullOrWhiteSpace(row.Creator) ? "—" : row.Creator)</div>
                                    <div class="line-clamp-1 max-w-xs text-xs text-muted">@row.Description</div>
                                    <div class="text-[11px] text-faint">@row.VideoId</div>
                                </td>
                                <td class="px-3 py-2">
                                    @{
                                        var badge = TranscriptBadge(row.Status);
                                    }
                                    <span class="badge @badge.Class">@badge.Label</span>
                                </td>
                                <td class="px-3 py-2">
                                    @if (row.Confidence.HasValue)
                                    {
                                        if (row.Confidence.Value < TranscriptionSvc.LowConfidenceThreshold)
                                        {
                                            <span class="inline-flex items-center gap-1 text-amber-600 dark:text-amber-400" title="Low confidence">
                                                <Icon Name="warning" Class="size-4" /> @row.Confidence.Value.ToString("P0")
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">@row.Confidence.Value.ToString("P0")</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-faint">—</span>
                                    }
                                </td>
                                <td class="px-3 py-2 text-ink">@row.RetryCount</td>
                                <td class="whitespace-nowrap px-3 py-2 text-muted">@(row.LastAttempt?.ToLocalTime().ToString("g") ?? "—")</td>
                                <td class="px-3 py-2">
                                    @if (!string.IsNullOrEmpty(row.Error))
                                    {
                                        <button class="inline-flex cursor-pointer items-center gap-1 text-sm text-rose-600 hover:text-rose-500 dark:text-rose-400 dark:hover:text-rose-300"
                                                @onclick="@(() => ShowTranscriptError(row.VideoId, row.Error!))">
                                            <Icon Name="error" Class="size-4" /> View
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="text-faint">—</span>
                                    }
                                </td>
                                <td class="px-3 py-2 text-right">
                                    <div class="flex items-center justify-end gap-3">
                                        @if (row.Status == TranscriptStatus.Completed)
                                        {
                                            <button class="inline-flex items-center gap-1 text-sm text-rose-600 hover:text-rose-500 dark:text-rose-400 dark:hover:text-rose-300"
                                                    @onclick="@(() => DeleteTranscript(row.VideoId))" title="Delete transcript">
                                                <Icon Name="trash" Class="size-4" /> Delete
                                            </button>
                                        }
                                        <button class="inline-flex items-center gap-1 text-sm text-sky-600 hover:text-sky-500 dark:text-sky-400 dark:hover:text-sky-300"
                                                @onclick="@(() => QueueTranscription(row.VideoId))"
                                                title="@(row.Status == TranscriptStatus.Completed ? "Re-transcribe" : "Queue transcription")">
                                            <Icon Name="refresh" Class="size-4" />
                                            @(row.Status == TranscriptStatus.Completed ? "Re-queue" : "Queue")
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (TranscriptTotalPages > 1)
            {
                <div class="mt-3 flex items-center justify-end gap-2 text-sm text-muted">
                    <button class="icon-btn size-8" disabled="@(transcriptPage == 1)" @onclick="@(() => transcriptPage--)" title="Previous page">
                        <Icon Name="chevron-left" Class="size-4" />
                    </button>
                    <span>Page @transcriptPage of @TranscriptTotalPages</span>
                    <button class="icon-btn size-8" disabled="@(transcriptPage == TranscriptTotalPages)" @onclick="@(() => transcriptPage++)" title="Next page">
                        <Icon Name="chevron-right" Class="size-4" />
                    </button>
                </div>
            }
        }
    </div>
}

else if (activeTab == 3)
{
    <!-- AI Provider -->
    <div class="card mb-4">
        <h2 class="mb-4 text-base font-semibold text-ink">AI Provider</h2>

        <label class="label">Provider</label>
        <div class="mb-4 flex flex-wrap gap-4">
            <label class="inline-flex items-center gap-2 text-sm text-ink">
                <input type="radio" name="aiProvider" checked="@(aiProvider == AiProvider.Local)"
                       @onchange="@(() => aiProvider = AiProvider.Local)" />
                Local model (Ollama)
            </label>
            <label class="inline-flex items-center gap-2 text-sm text-ink">
                <input type="radio" name="aiProvider" checked="@(aiProvider == AiProvider.Gemini)"
                       @onchange="@(() => aiProvider = AiProvider.Gemini)" />
                Google Gemini
            </label>
        </div>

        <label class="label" for="geminiApiKey">Gemini API key</label>
        <input id="geminiApiKey" type="password" autocomplete="off" class="input mb-1"
               placeholder="@(geminiApiKeyConfigured ? "•••••••••••••• (saved — leave blank to keep)" : "Enter Gemini API key")"
               @bind="geminiApiKeyInput" @bind:event="oninput" />
        <p class="mb-4 text-xs text-faint">
            @(geminiApiKeyConfigured
                ? "A key is already saved. Leave this blank to keep it, or enter a new one to replace it."
                : "Required to use Gemini.")
        </p>

        <label class="label" for="geminiModel">Model</label>
        <div class="mb-1 flex flex-wrap items-center gap-2">
            <select id="geminiModel" class="input max-w-xs" @bind="selectedGeminiModel">
                @if (geminiModels.Count == 0)
                {
                    <option value="@selectedGeminiModel">
                        @(string.IsNullOrWhiteSpace(selectedGeminiModel) ? "Fetch models to choose one" : selectedGeminiModel)
                    </option>
                }
                else
                {
                    @foreach (var model in geminiModels)
                    {
                        <option value="@model.Id">@model.DisplayName</option>
                    }
                }
            </select>
            <button type="button" class="btn btn-ghost" @onclick="FetchGeminiModels" disabled="@isFetchingGeminiModels">
                @if (isFetchingGeminiModels)
                {
                    <span class="spinner size-4"></span>
                }
                else
                {
                    <Icon Name="refresh" Class="size-4" />
                }
                Fetch models
            </button>
        </div>
        <p class="mb-4 text-xs text-faint">
            Fetches the models available to the key above (or the saved key, if you haven't typed a new one).
        </p>

        <div class="mb-1 flex items-center justify-between">
            <label class="label" for="systemPrompt">System prompt</label>
            <button type="button" class="text-xs text-sky-600 hover:text-sky-500 dark:text-sky-400 dark:hover:text-sky-300"
                    @onclick="ResetSystemPromptToDefault">
                Reset to default
            </button>
        </div>
        <textarea id="systemPrompt" rows="5" class="input mb-1 font-mono text-xs" @bind="systemPromptInput" @bind:event="oninput"></textarea>
        <p class="mb-4 text-xs text-faint">
            Sent as the instruction for every AI summary, on both providers. Must still ask for a JSON object
            of the form <code>{"summary": string, "tags": string[]}</code> — the enrichment worker parses that shape.
        </p>

        <button class="btn btn-primary" @onclick="SaveAiProviderSettings" disabled="@isSavingAiProvider">
            @if (isSavingAiProvider)
            {
                <span class="spinner size-4"></span>
            }
            Save Provider Settings
        </button>

        @if (aiProviderLastModified.HasValue)
        {
            <p class="mt-2 text-xs text-faint">
                Last modified: @aiProviderLastModified.Value.ToLocalTime().ToString("g")
            </p>
        }
    </div>

    <!-- AI Enrichment -->
    <div class="card">
        <div class="mb-4 flex flex-wrap items-center gap-2">
            <h2 class="flex-1 text-base font-semibold text-ink">AI Enrichment Queue</h2>
            <button class="btn btn-ghost" @onclick="RefreshAiEnrichmentData" disabled="@aiRefreshing">
                <Icon Name="refresh" Class="@($"size-4 {(aiRefreshing ? "animate-spin" : "")}")" />
                @(aiRefreshing ? "Refreshing…" : "Refresh")
            </button>
        </div>

        <div class="mb-4 flex flex-wrap gap-2">
            <span class="badge badge-info">Pending: @AiCount(AiSummaryStatus.Pending)</span>
            <span class="badge badge-success">Completed: @AiCount(AiSummaryStatus.Completed)</span>
            <span class="badge badge-danger">Failed: @AiCount(AiSummaryStatus.Failed)</span>
            <span class="badge bg-surface-2 text-muted">Skipped: @AiCount(AiSummaryStatus.Skipped)</span>
            <span class="badge bg-surface-2 text-muted">Not requested: @AiCount(AiSummaryStatus.NotRequested)</span>
        </div>

        <div class="mb-5 flex flex-wrap gap-2">
            <button class="btn btn-primary" @onclick="RetryFailedAiSummaries"
                    disabled="@(AiCount(AiSummaryStatus.Failed) == 0)">
                <Icon Name="refresh" Class="size-4" /> Retry failed (@AiCount(AiSummaryStatus.Failed))
            </button>
            <button class="btn btn-ghost" @onclick="BackfillAiSummaries"
                    disabled="@(AiCount(AiSummaryStatus.NotRequested) == 0)">
                <Icon Name="sparkles" Class="size-4" /> Enrich back-catalog (@AiCount(AiSummaryStatus.NotRequested))
            </button>
        </div>

        <div class="mb-5 rounded-lg border border-line p-3">
            <p class="mb-2 text-xs font-medium uppercase tracking-wide text-muted">Re-run by provider</p>
            <div class="flex flex-wrap items-center gap-2">
                <button class="btn btn-ghost" @onclick="@(() => RequeueByProvider(AiProvider.Local))"
                        disabled="@(aiRequeuingProvider || AiProviderCount(AiProvider.Local) == 0)">
                    <Icon Name="refresh" Class="size-4" /> Re-queue Local results (@AiProviderCount(AiProvider.Local))
                </button>

                <select class="input max-w-xs" @bind="selectedRequeueGeminiModel"
                        disabled="@(AiProviderCount(AiProvider.Gemini) == 0)">
                    <option value="">All Gemini models (@AiProviderCount(AiProvider.Gemini))</option>
                    @foreach (var (model, count) in geminiModelCounts.OrderByDescending(kv => kv.Value))
                    {
                        <option value="@model">@model (@count)</option>
                    }
                </select>
                <button class="btn btn-ghost" @onclick="RequeueGeminiSelection"
                        disabled="@(aiRequeuingProvider || AiProviderCount(AiProvider.Gemini) == 0)">
                    <Icon Name="refresh" Class="size-4" /> Re-queue Gemini results
                </button>

                <button class="btn btn-ghost" @onclick="@(() => RequeueByProvider(null))"
                        disabled="@(aiRequeuingProvider || AiProviderCount(null) == 0)"
                        title="Videos summarized before provider tracking was added">
                    <Icon Name="refresh" Class="size-4" /> Re-queue Unknown results (@AiProviderCount(null))
                </button>
            </div>
            <p class="mt-2 text-xs text-faint">
                Re-queued videos are re-enriched using whichever provider is selected above (currently
                <strong>@(aiProvider == AiProvider.Gemini ? "Gemini" : "Local model")</strong>) when the worker next picks them up.
            </p>
        </div>

        <div class="mb-3 flex flex-wrap items-center gap-2">
            <span class="text-xs text-faint">Show:</span>
            @foreach (var filter in aiFilters)
            {
                var active = aiFilter == filter.Key;
                <button class="@($"chip {(active ? "chip-active" : "chip-inactive")}")"
                        @onclick="@(() => SetAiFilter(filter.Key))">
                    @filter.Label
                </button>
            }
        </div>

        @if (aiVideos.Count == 0)
        {
            <p class="text-sm text-faint">No videos in this view.</p>
        }
        else
        {
            <div class="overflow-x-auto rounded-lg border border-line">
                <table class="w-full text-left text-sm">
                    <thead class="bg-surface-2 text-xs uppercase tracking-wide text-muted">
                        <tr>
                            <th class="px-3 py-2 font-medium">Video</th>
                            <th class="px-3 py-2 font-medium">Status</th>
                            <th class="px-3 py-2 font-medium">Summary</th>
                            <th class="px-3 py-2 font-medium">Provider / Model</th>
                            <th class="px-3 py-2 font-medium">Retries</th>
                            <th class="px-3 py-2 font-medium">Last Attempt</th>
                            <th class="px-3 py-2 font-medium">Error</th>
                            <th class="px-3 py-2 text-right font-medium">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-line">
                        @foreach (var row in PagedAiRows)
                        {
                            <tr class="align-top hover:bg-surface-2">
                                <td class="px-3 py-2">
                                    <div class="font-medium text-ink">@(string.IsNullOrWhiteSpace(row.Creator) ? "—" : row.Creator)</div>
                                    <div class="line-clamp-1 max-w-xs text-xs text-muted">@row.Description</div>
                                    <div class="text-[11px] text-faint">@row.VideoId</div>
                                </td>
                                <td class="px-3 py-2">
                                    @{
                                        var badge = AiBadge(row.Status);
                                    }
                                    <span class="badge @badge.Class">@badge.Label</span>
                                </td>
                                <td class="px-3 py-2">
                                    @if (!string.IsNullOrWhiteSpace(row.Summary))
                                    {
                                        <span class="line-clamp-2 max-w-xs text-xs text-muted">@row.Summary</span>
                                    }
                                    else
                                    {
                                        <span class="text-faint">—</span>
                                    }
                                </td>
                                <td class="px-3 py-2">
                                    @if (row.Provider.HasValue || row.Status == AiSummaryStatus.Completed)
                                    {
                                        <span class="text-xs text-ink">@AiProviderLabel(row.Provider)</span>
                                        @if (!string.IsNullOrWhiteSpace(row.Model))
                                        {
                                            <div class="text-[11px] text-faint">@row.Model</div>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-faint">—</span>
                                    }
                                </td>
                                <td class="px-3 py-2 text-ink">@row.RetryCount</td>
                                <td class="whitespace-nowrap px-3 py-2 text-muted">@(row.LastAttempt?.ToLocalTime().ToString("g") ?? "—")</td>
                                <td class="px-3 py-2">
                                    @if (!string.IsNullOrEmpty(row.Error))
                                    {
                                        <button class="inline-flex cursor-pointer items-center gap-1 text-sm text-rose-600 hover:text-rose-500 dark:text-rose-400 dark:hover:text-rose-300"
                                                @onclick="@(() => ShowAiError(row.VideoId, row.Error!))">
                                            <Icon Name="error" Class="size-4" /> View
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="text-faint">—</span>
                                    }
                                </td>
                                <td class="px-3 py-2 text-right">
                                    <div class="flex items-center justify-end gap-3">
                                        @if (row.Status == AiSummaryStatus.Completed)
                                        {
                                            <button class="inline-flex items-center gap-1 text-sm text-rose-600 hover:text-rose-500 dark:text-rose-400 dark:hover:text-rose-300"
                                                    @onclick="@(() => DeleteAiSummary(row.VideoId))" title="Delete summary and AI tags">
                                                <Icon Name="trash" Class="size-4" /> Delete
                                            </button>
                                        }
                                        <button class="inline-flex items-center gap-1 text-sm text-sky-600 hover:text-sky-500 dark:text-sky-400 dark:hover:text-sky-300"
                                                @onclick="@(() => QueueAiSummary(row.VideoId))"
                                                title="@(row.Status == AiSummaryStatus.Completed ? "Re-enrich" : "Queue enrichment")">
                                            <Icon Name="refresh" Class="size-4" />
                                            @(row.Status == AiSummaryStatus.Completed ? "Re-queue" : "Queue")
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (AiTotalPages > 1)
            {
                <div class="mt-3 flex items-center justify-end gap-2 text-sm text-muted">
                    <button class="icon-btn size-8" disabled="@(aiPage == 1)" @onclick="@(() => aiPage--)" title="Previous page">
                        <Icon Name="chevron-left" Class="size-4" />
                    </button>
                    <span>Page @aiPage of @AiTotalPages</span>
                    <button class="icon-btn size-8" disabled="@(aiPage == AiTotalPages)" @onclick="@(() => aiPage++)" title="Next page">
                        <Icon Name="chevron-right" Class="size-4" />
                    </button>
                </div>
            }
        }
    </div>
}

@if (showErrorDialog)
{
    <ImportErrorDialog Title="@errorDialogTitle"
                       ErrorMessage="@errorDialogMessage"
                       OnClose="@(() => showErrorDialog = false)" />
}

@if (indexPendingDelete != null)
{
    <ConfirmDialog Title="Delete index"
                   Message="@($"Permanently delete the index '{indexPendingDelete.Name}' and its {indexPendingDelete.DocsCount:N0} document(s)? This cannot be undone.")"
                   ConfirmText="Delete"
                   OnConfirm="ConfirmDeleteIndex"
                   OnCancel="@(() => indexPendingDelete = null)" />
}

@code {
    private int activeTab = 0;

    private int syncIntervalMinutes = 30;
