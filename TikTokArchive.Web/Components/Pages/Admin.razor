    private string geminiApiKeyInput = string.Empty;
    private bool geminiApiKeyConfigured = false;
    private string? selectedGeminiModel;
    private List<GeminiModelInfo> geminiModels = new();
    private bool isFetchingGeminiModels = false;
    private string systemPromptInput = string.Empty;
    private DateTime? aiProviderLastModified;
    private bool isSavingAiProvider = false;

    // AI Enrichment
    private static readonly (string Key, string Label)[] aiFilters =
    {
        ("queue", "Queue"),                 // active queue: Pending + Failed
        ("pending", "Pending"),
        ("failed", "Failed"),
        ("completed", "Completed"),
        ("skipped", "Skipped"),
        ("notrequested", "Not requested"),
    };
    private Dictionary<AiSummaryStatus, int> aiCounts = new();
    private Dictionary<AiProvider, int> aiProviderCounts = new();
    private int aiUnknownProviderCount;
    private Dictionary<string, int> geminiModelCounts = new();
    private string selectedRequeueGeminiModel = string.Empty;
    private string aiFilter = "queue";
    private List<AiRow> aiVideos = new();
