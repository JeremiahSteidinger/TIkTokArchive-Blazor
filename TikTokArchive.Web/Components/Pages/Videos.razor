@page "/videos"
@inject TikTokArchive.Web.Services.IVideoService VideoService
@inject TikTokArchive.Web.Services.VideoIngestQueue IngestQueue
@inject TikTokArchive.Web.Services.ITranscriptionService TranscriptionSvc
@inject TikTokArchive.Web.Services.IAiEnrichmentService AiEnrichmentSvc
@inject IJSRuntime JSRuntime
@inject ToastService Toast
@using TikTokArchive.Entities
@using TikTokArchive.Web.Services
@implements IDisposable

<div class="space-y-4">
    <!-- Add Video -->
    <div class="card">
        <div class="flex items-center justify-between">
            <h2 class="text-lg font-semibold text-ink">Add Video</h2>
            <button class="icon-btn" @onclick="@(() => showAddVideo = !showAddVideo)"
                    title="@(showAddVideo ? "Hide" : "Add video")">
                <Icon Name="@(showAddVideo ? "minus" : "plus")" />
            </button>
        </div>

        @if (showAddVideo)
        {
            <div class="mt-3 flex flex-col gap-2 sm:flex-row">
                <input class="input" @bind="newVideoUrl" @bind:event="oninput"
                       placeholder="Enter TikTok video URL" aria-label="TikTok Video URL" />
                <button class="btn btn-primary shrink-0" @onclick="SubmitVideo"
                        disabled="@(string.IsNullOrWhiteSpace(newVideoUrl))">
                    Submit
                </button>
            </div>
        }
    </div>

    <!-- Downloads -->
    @if (ingestJobs.Count > 0)
    {
        <div class="card">
            <h3 class="mb-3 text-xs font-semibold uppercase tracking-wide text-muted">Downloads</h3>
            <div class="space-y-2">
                @foreach (var job in ingestJobs)
                {
                    @if (job.Status == IngestJobStatus.Failed)
                    {
                        <div class="alert alert-danger">
                            <Icon Name="error" Class="size-5 shrink-0 text-rose-500" />
                            <div class="min-w-0 flex-1">
                                <p class="break-all">@job.Url</p>
                                <p class="text-xs opacity-80">@job.Error</p>
                            </div>
                            <button class="icon-btn size-7 shrink-0" @onclick="@(() => DismissJob(job))" title="Dismiss">
                                <Icon Name="close" Class="size-4" />
                            </button>
                        </div>
                    }
                    else
                    {
                        <div class="flex items-center gap-3">
                            <span class="spinner size-4"></span>
                            <span class="text-sm text-ink">@JobStatusText(job.Status)</span>
                            <span class="min-w-0 truncate text-xs text-faint">@job.Url</span>
                        </div>
                    }
                }
            </div>
        </div>
    }

    <!-- Search -->
    <div class="card">
        <div class="relative">
            <span class="pointer-events-none absolute inset-y-0 left-3 flex items-center text-faint">
                <Icon Name="search" Class="size-5" />
            </span>
            <input class="input pl-10" @bind="searchQuery" @bind:event="oninput" @onkeyup="HandleSearchKeyUp"
                   placeholder="Search descriptions, creators, or tags" aria-label="Search videos" />
        </div>

        <div class="mt-3 flex flex-wrap items-center gap-2">
            <span class="text-xs text-faint">Search in:</span>
            @foreach (var field in searchFieldOptions)
            {
                var active = searchFields.Contains(field.Key);
                <button class="@($"chip {(active ? "chip-active" : "chip-inactive")}")"
                        @onclick="@(() => ToggleSearchField(field.Key))">
                    @field.Label
                </button>
            }
        </div>
    </div>

    @if (!string.IsNullOrEmpty(selectedTag))
    {
        <div>
            <span class="badge bg-sky-600 text-white">
                Filtered by: @selectedTag
                <button @onclick="ClearTagFilter" class="ml-1 text-sky-100 hover:text-white" aria-label="Clear filter">
                    <Icon Name="close" Class="size-3.5" />
                </button>
            </span>
        </div>
    }
</div>

@if (isLoading)
{
    <div class="mt-8 flex justify-center">
        <span class="spinner size-8"></span>
    </div>
}
else
{
    <div class="mt-6 space-y-5">
        @if (!videos.Any())
        {
            <div class="alert alert-info items-center">
                <Icon Name="info" Class="size-5 shrink-0 text-sky-500" />
                @if (!string.IsNullOrEmpty(selectedTag))
                {
                    <span>No videos found with tag "@selectedTag".</span>
                }
                else
                {
                    <span>No videos found.</span>
                }
            </div>
        }
        else
        {
            <div class="grid grid-cols-[repeat(auto-fill,minmax(300px,1fr))] gap-5">
                @foreach (var video in videos)
                {
                    <div class="flex flex-col overflow-hidden rounded-xl border border-line bg-surface">
                        <div class="p-3">
                            @if (!string.IsNullOrWhiteSpace(video.TikTokVideoId))
                            {
                                var videoUrl = $"/api/video/{video.TikTokVideoId}/stream";
                                var posterUrl = $"/api/video/{video.TikTokVideoId}/thumbnail";
                                <video id="@video.Id"
                                       controls
                                       preload="metadata"
                                       class="w-full rounded-lg bg-black"
                                       poster="@posterUrl">
                                    <source src="@videoUrl" type="video/mp4" />
                                    Your browser does not support the video tag.
                                </video>
                            }
                            <p class="mt-3 text-sm font-semibold text-ink">@video.Creator?.DisplayName</p>
                            <p class="mt-1 text-sm text-muted">@video.Description</p>
                            @if (!string.IsNullOrWhiteSpace(video.Summary))
                            {
                                <p class="mt-2 flex gap-1.5 text-sm italic text-faint">
                                    <Icon Name="sparkles" Class="size-4 shrink-0 text-violet-500" />
                                    <span>@video.Summary</span>
                                </p>
                            }
                            @if (video.Tags.Any())
                            {
                                <div class="mt-3 flex flex-wrap gap-1.5">
                                    @foreach (var tag in video.Tags)
                                    {
                                        @if (tag.Source == TagSource.Ai)
                                        {
                                            <span class="chip chip-ai" title="AI-generated tag">
                                                <button class="inline-flex items-center gap-1"
                                                        @onclick="@(() => FilterByTag(tag.Tag.Name))">
                                                    <Icon Name="sparkles" Class="size-3" />@tag.Tag.Name
                                                </button>
                                                <button class="-mr-1 ml-0.5 rounded-full p-0.5 hover:bg-violet-500/25"
                                                        @onclick="@(() => RemoveAiTag(video, tag))"
                                                        title="Remove AI tag" aria-label="Remove AI tag">
                                                    <Icon Name="close" Class="size-3" />
                                                </button>
                                            </span>
                                        }
                                        else
                                        {
                                            var tagActive = selectedTag == tag.Tag.Name;
                                            <button class="@($"chip {(tagActive ? "bg-rose-600 text-white" : "bg-surface-2 text-sky-700 hover:text-sky-500 dark:text-sky-300 dark:hover:text-sky-200")}")"
                                                    @onclick="@(() => FilterByTag(tag.Tag.Name))">
                                                #@tag.Tag.Name
                                            </button>
                                        }
                                    }
                                </div>
                            }
                        </div>
                        <div class="mt-auto flex items-center justify-between border-t border-line px-3 py-2">
                            <div class="flex items-center gap-1">
                                <a class="icon-btn" href="@GetDownloadUrl(video.TikTokVideoId)" target="_blank" title="Download video">
                                    <Icon Name="download" />
                                </a>
                                @switch (video.TranscriptStatus)
                                {
                                    case TranscriptStatus.Completed:
                                        <button class="@($"icon-btn {(IsLowConfidence(video) ? "text-amber-500 hover:bg-amber-500/10" : "text-emerald-500 hover:bg-emerald-500/10")}")"
                                                @onclick="@(() => ShowTranscript(video))"
                                                title="@(IsLowConfidence(video) ? "Transcript (low confidence) — click to view" : "View transcript")">
                                            <Icon Name="document-text" />
                                        </button>
                                        break;
                                    case TranscriptStatus.Pending:
                                        <span class="icon-btn cursor-default text-amber-500" title="Queued for transcription">
                                            <Icon Name="clock" />
                                        </span>
                                        break;
                                    case TranscriptStatus.Failed:
                                        <button class="icon-btn text-rose-500 hover:bg-rose-500/10"
                                                @onclick="@(() => QueueTranscription(video))" title="Transcription failed — click to retry">
                                            <Icon Name="refresh" />
                                        </button>
                                        break;
                                    case TranscriptStatus.Skipped:
                                        <button class="icon-btn text-muted hover:bg-surface-2"
                                                @onclick="@(() => QueueTranscription(video))" title="No audio / skipped — click to transcribe again">
                                            <Icon Name="speaker-x" />
                                        </button>
                                        break;
                                    default: // NotRequested
                                        <button class="icon-btn hover:bg-sky-500/10 hover:text-sky-500"
                                                @onclick="@(() => QueueTranscription(video))" title="Queue transcription">
                                            <Icon Name="microphone" />
                                        </button>
                                        break;
                                }
                                @switch (video.AiSummaryStatus)
                                {
                                    case AiSummaryStatus.Completed:
                                        <button class="icon-btn text-violet-500 hover:bg-violet-500/10"
                                                @onclick="@(() => QueueAiEnrichment(video))"
                                                title="AI enriched — click to regenerate">
                                            <Icon Name="sparkles" />
                                        </button>
                                        break;
                                    case AiSummaryStatus.Pending:
                                        <span class="icon-btn cursor-default text-amber-500" title="Queued for AI enrichment">
                                            <Icon Name="clock" />
                                        </span>
                                        break;
                                    case AiSummaryStatus.Failed:
                                        <button class="icon-btn text-rose-500 hover:bg-rose-500/10"
                                                @onclick="@(() => QueueAiEnrichment(video))" title="AI enrichment failed — click to retry">
                                            <Icon Name="refresh" />
                                        </button>
                                        break;
                                    case AiSummaryStatus.Skipped:
                                        <button class="icon-btn text-muted hover:bg-violet-500/10 hover:text-violet-500"
                                                @onclick="@(() => QueueAiEnrichment(video))" title="AI enrichment skipped — click to enrich again">
                                            <Icon Name="sparkles" />
                                        </button>
                                        break;
                                    default: // NotRequested
                                        <button class="icon-btn hover:bg-violet-500/10 hover:text-violet-500"
                                                @onclick="@(() => QueueAiEnrichment(video))" title="Queue AI enrichment">
                                            <Icon Name="sparkles" />
                                        </button>
                                        break;
                                }
                            </div>
                            <button class="icon-btn hover:bg-rose-500/10 hover:text-rose-500"
                                    @onclick="@(() => DeleteVideo(video.TikTokVideoId))" title="Delete video">
                                <Icon Name="trash" />
                            </button>
                        </div>
                    </div>
                }
            </div>

            @if (totalPages > 1)
            {
                <div class="flex flex-col items-center gap-2 pt-2">
                    <nav class="flex items-center gap-1">
                        <button class="icon-btn" disabled="@(currentPage == 1)"
                                @onclick="@(() => OnPageChanged(1))" title="First page">
                            <Icon Name="chevron-double-left" Class="size-4" />
                        </button>
                        <button class="icon-btn" disabled="@(currentPage == 1)"
                                @onclick="@(() => OnPageChanged(currentPage - 1))" title="Previous page">
                            <Icon Name="chevron-left" Class="size-4" />
                        </button>
                        @foreach (var page in PageNumbers())
                        {
                            <button class="@($"inline-flex h-9 min-w-9 items-center justify-center rounded-lg px-3 text-sm font-medium transition-colors {(page == currentPage ? "bg-sky-600 text-white" : "text-muted hover:bg-surface-2")}")"
                                    @onclick="@(() => OnPageChanged(page))">
                                @(page)
                            </button>
                        }
                        <button class="icon-btn" disabled="@(currentPage == totalPages)"
                                @onclick="@(() => OnPageChanged(currentPage + 1))" title="Next page">
                            <Icon Name="chevron-right" Class="size-4" />
                        </button>
                        <button class="icon-btn" disabled="@(currentPage == totalPages)"
                                @onclick="@(() => OnPageChanged(totalPages))" title="Last page">
                            <Icon Name="chevron-double-right" Class="size-4" />
                        </button>
                    </nav>
                    <p class="text-xs text-faint">
                        Showing @((currentPage - 1) * pageSize + 1) to @Math.Min(currentPage * pageSize, totalCount) of @totalCount videos
                    </p>
                </div>
            }
        }
    </div>
}

@if (showTranscriptDialog && transcriptDialogVideo != null)
{
    <TranscriptDialog Title="@transcriptDialogTitle"
                      Transcript="@transcriptDialogVideo.Transcript"
                      Confidence="@transcriptDialogVideo.TranscriptConfidence"
                      IsLowConfidence="@IsLowConfidence(transcriptDialogVideo)"
                      OnClose="@(() => showTranscriptDialog = false)"
                      OnDelete="@(() => DeleteTranscript(transcriptDialogVideo))" />
}

@code {
    private static readonly (string Key, string Label)[] searchFieldOptions =
    {
        ("all", "All"),
        ("description", "Description"),
        ("creator", "Creator"),
        ("tags", "Tags"),
        ("transcript", "Transcript"),
        ("summary", "Summary")
    };

    private List<Video> videos = new();
    private HashSet<string> loadedVideos = new();
    private string? selectedTag;
    private bool isLoading = true;
    private string newVideoUrl = string.Empty;
    private bool showAddVideo = false;
    private int currentPage = 1;
    private int pageSize = 20;
    private string searchQuery = string.Empty;
    private List<string> searchFields = new() { "all" };
    private System.Timers.Timer? searchDebounceTimer;
    private int totalCount = 0;
    private int totalPages => (int)Math.Ceiling(totalCount / (double)pageSize);

    private IReadOnlyList<IngestJob> ingestJobs = Array.Empty<IngestJob>();
    private readonly HashSet<Guid> notifiedJobs = new();
    private System.Timers.Timer? jobPollTimer;
    private System.Timers.Timer? statusPollTimer;

    private bool showTranscriptDialog = false;
    private string transcriptDialogTitle = string.Empty;
    private Video? transcriptDialogVideo;

    private IEnumerable<int> PageNumbers()
    {
        const int window = 2;
        var start = Math.Max(1, currentPage - window);
        var end = Math.Min(totalPages, currentPage + window);
        for (var i = start; i <= end; i++)
        {
            yield return i;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        // Pick up downloads from a previous visit without re-announcing finished ones;
        // failed jobs stay visible in the panel until dismissed.
        foreach (var job in IngestQueue.GetJobs().Where(j => j.IsFinished))
        {
            notifiedJobs.Add(job.Id);
        }
        RefreshIngestJobList();
        if (ingestJobs.Any(j => !j.IsFinished))
        {
            StartJobPolling();
        }

        await LoadVideos();
    }

    private void LoadVideo(string videoId)
    {
        loadedVideos.Add(videoId);
        StateHasChanged();
    }

    // showLoading is suppressed for background status refreshes so the grid isn't briefly
    // replaced by the loading spinner while a poll re-fetches the page.
    private async Task LoadVideos(bool showLoading = true)
    {
        if (showLoading)
        {
            isLoading = true;
        }
        loadedVideos.Clear(); // Clear loaded videos when navigating pages
        try
        {
            var searchQueryParam = string.IsNullOrWhiteSpace(searchQuery) ? null : searchQuery;
            var searchFieldsParam = searchFields.Contains("all") ? null : searchFields;

            var (loadedVideos, count) = await VideoService.GetVideosAsync(currentPage, pageSize, selectedTag, searchQueryParam, searchFieldsParam);
            videos = loadedVideos;
            totalCount = count;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading videos: {ex.Message}");
            videos = new List<Video>();
            totalCount = 0;
        }
        finally
        {
            if (showLoading)
            {
                isLoading = false;
            }
        }

        // Whenever the visible set changes, (re)start polling if any of these videos are still
        // being transcribed or enriched, so their card icons update as the workers finish.
        StartStatusPolling();
    }

    private void HandleSearchKeyUp(KeyboardEventArgs e)
    {
        searchDebounceTimer?.Stop();
        searchDebounceTimer = new System.Timers.Timer(500);
        searchDebounceTimer.Elapsed += async (sender, args) =>
        {
            searchDebounceTimer?.Stop();
            await InvokeAsync(async () =>
            {
                currentPage = 1;
                await LoadVideos();
                StateHasChanged();
            });
        };
        searchDebounceTimer.Start();
    }

    private async Task ToggleSearchField(string field)
    {
        if (field == "all")
        {
            searchFields.Clear();
            searchFields.Add("all");
        }
        else
        {
            searchFields.Remove("all");
            if (searchFields.Contains(field))
            {
                searchFields.Remove(field);
                if (searchFields.Count == 0)
                {
                    searchFields.Add("all");
                }
            }
            else
            {
                searchFields.Add(field);
            }
        }

        if (!string.IsNullOrWhiteSpace(searchQuery))
        {
            currentPage = 1;
            await LoadVideos();
        }
    }

    private void SubmitVideo()
    {
        try
        {
            IngestQueue.Enqueue(newVideoUrl);
            Toast.Show("Video queued for download", ToastSeverity.Info);
            newVideoUrl = string.Empty;
            RefreshIngestJobList();
            StartJobPolling();
        }
        catch (ArgumentException ex)
        {
            Toast.Show(ex.Message, ToastSeverity.Warning);
        }
    }

    private void StartJobPolling()
    {
        if (jobPollTimer != null) return;

        jobPollTimer = new System.Timers.Timer(2000);
        jobPollTimer.Elapsed += async (sender, args) => await InvokeAsync(RefreshIngestJobsAsync);
        jobPollTimer.Start();
    }

    private void RefreshIngestJobList()
    {
        ingestJobs = IngestQueue.GetJobs()
            .Where(j => !j.IsFinished || (j.Status == IngestJobStatus.Failed && !j.Dismissed))
            .ToList();
    }

    private void DismissJob(IngestJob job)
    {
        job.Dismiss();
        RefreshIngestJobList();
    }

    private async Task RefreshIngestJobsAsync()
    {
        var jobs = IngestQueue.GetJobs();
        var finishedToAnnounce = jobs.Where(j => j.IsFinished && notifiedJobs.Add(j.Id)).ToList();

        foreach (var job in finishedToAnnounce)
        {
            if (job.Status == IngestJobStatus.Completed)
            {
                Toast.Show("Video added successfully!", ToastSeverity.Success);
            }
            else
            {
                Toast.Show($"Video download failed: {job.Error}", ToastSeverity.Error);
            }
        }

        RefreshIngestJobList();

        if (finishedToAnnounce.Any(j => j.Status == IngestJobStatus.Completed))
        {
            currentPage = 1; // Reset to first page to see the new video
            await LoadVideos();
        }

        if (!ingestJobs.Any(j => !j.IsFinished))
        {
            jobPollTimer?.Stop();
            jobPollTimer?.Dispose();
            jobPollTimer = null;
        }

        StateHasChanged();
    }

    // A video whose transcript or AI summary is still queued will change state when the
    // background worker finishes — those are the cards whose icons we want to keep live.
    private bool HasPendingWork() =>
        videos.Any(v => v.TranscriptStatus == TranscriptStatus.Pending
                     || v.AiSummaryStatus == AiSummaryStatus.Pending);

    private void StartStatusPolling()
    {
        if (statusPollTimer != null || !HasPendingWork()) return;

        statusPollTimer = new System.Timers.Timer(3000);
        statusPollTimer.Elapsed += async (sender, args) => await InvokeAsync(RefreshStatusesAsync);
        statusPollTimer.Start();
    }

    private void StopStatusPolling()
    {
        statusPollTimer?.Stop();
        statusPollTimer?.Dispose();
        statusPollTimer = null;
    }

    private async Task RefreshStatusesAsync()
    {
        var ids = videos.Select(v => v.TikTokVideoId).ToList();
        if (ids.Count == 0)
        {
            StopStatusPolling();
            return;
        }

        List<VideoStatus> statuses;
        try
        {
            statuses = await VideoService.GetStatusesAsync(ids);
        }
        catch
        {
            return; // transient DB hiccup — try again on the next tick
        }

        // Did any visible card's transcript / summary status change since we last loaded?
        var statusById = statuses.ToDictionary(s => s.VideoId);
        var changed = videos.Any(v =>
            statusById.TryGetValue(v.TikTokVideoId, out var s)
            && (s.TranscriptStatus != v.TranscriptStatus || s.AiSummaryStatus != v.AiSummaryStatus));

        if (changed)
        {
            // Reload (without the loading spinner) so the new summary text, transcript, and AI
            // tags arrive with the status — not just the icon. Ordering is stable (newest first),
            // so cards don't jump.
            await LoadVideos(showLoading: false);
            StateHasChanged();
        }

        // Nothing left in flight on this page — stop polling until something is queued again.
        if (!HasPendingWork())
        {
            StopStatusPolling();
        }
    }

    private static string JobStatusText(IngestJobStatus status) => status switch
    {
        IngestJobStatus.Queued => "Queued",
        IngestJobStatus.FetchingMetadata => "Fetching metadata…",
        IngestJobStatus.Downloading => "Downloading…",
        IngestJobStatus.Saving => "Saving…",
        _ => status.ToString()
    };

    public void Dispose()
    {
        searchDebounceTimer?.Dispose();
        jobPollTimer?.Dispose();
        statusPollTimer?.Dispose();
    }

    private async Task OnPageChanged(int page)
    {
        currentPage = page;
        await LoadVideos();
    }

    private async Task FilterByTag(string tag)
    {
        selectedTag = tag;
        currentPage = 1;
        await LoadVideos();
    }

    private async Task ClearTagFilter()
    {
        selectedTag = null;
        currentPage = 1;
        await LoadVideos();
    }

    private async Task DeleteVideo(string videoId)
    {
        if (!await JSRuntime.InvokeAsync<bool>("confirm", $"Are you sure you want to delete video {videoId}?"))
        {
            return;
        }

        try
        {
            await VideoService.DeleteVideoAsync(videoId);

            if (videos.Count == 1 && currentPage > 1)
            {
                currentPage--;
            }

            await LoadVideos();
            Toast.Show("Video deleted successfully", ToastSeverity.Success);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error deleting video: {ex.Message}");
            Toast.Show($"Error deleting video: {ex.Message}", ToastSeverity.Error);
        }
    }

    private string GetDownloadUrl(string videoId)
    {
        return $"/api/video/{videoId}/download";
    }

    private async Task RemoveAiTag(Video video, VideoTag tag)
    {
        try
        {
            if (await VideoService.RemoveTagFromVideoAsync(video.TikTokVideoId, tag.TagId))
            {
                // Drop it from the in-memory list so the chip disappears without a reload.
                video.Tags = video.Tags.Where(t => t.TagId != tag.TagId).ToList();
                Toast.Show("AI tag removed", ToastSeverity.Success);
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Toast.Show($"Error removing tag: {ex.Message}", ToastSeverity.Error);
        }
    }

    private async Task QueueTranscription(Video video)
    {
        try
        {
            if (await TranscriptionSvc.QueueAsync(video.TikTokVideoId))
            {
                // Reflect the new state immediately; the worker processes it in the background.
                video.TranscriptStatus = TranscriptStatus.Pending;
                Toast.Show("Queued for transcription", ToastSeverity.Success);
                StartStatusPolling(); // keep the card's icon live until the worker finishes
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Toast.Show($"Error queueing transcription: {ex.Message}", ToastSeverity.Error);
        }
    }

    private async Task QueueAiEnrichment(Video video)
    {
        try
        {
            if (await AiEnrichmentSvc.QueueAsync(video.TikTokVideoId))
            {
                // Reflect the new state immediately; the worker enriches once the transcript is
                // ready (it may already be), in the background.
                video.AiSummaryStatus = AiSummaryStatus.Pending;
                Toast.Show("Queued for AI enrichment", ToastSeverity.Success);
                StartStatusPolling(); // keep the card's icon live until the worker finishes
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Toast.Show($"Error queueing AI enrichment: {ex.Message}", ToastSeverity.Error);
        }
    }

    private void ShowTranscript(Video video)
    {
        transcriptDialogTitle = string.IsNullOrWhiteSpace(video.Creator?.DisplayName)
            ? "Transcript"
            : $"Transcript — {video.Creator!.DisplayName}";
        transcriptDialogVideo = video;
        showTranscriptDialog = true;
    }

    private bool IsLowConfidence(Video video) =>
        video.TranscriptConfidence is double c && c < TranscriptionSvc.LowConfidenceThreshold;

    private async Task DeleteTranscript(Video video)
    {
        if (!await JSRuntime.InvokeAsync<bool>("confirm",
            "Delete this transcript? It will also be removed from search."))
        {
            return;
        }

        try
        {
            if (await TranscriptionSvc.DeleteTranscriptAsync(video.TikTokVideoId))
            {
                // Reflect the cleared state in the list immediately.
                video.Transcript = null;
                video.TranscriptConfidence = null;
                video.TranscriptStatus = TranscriptStatus.Skipped;
                showTranscriptDialog = false;
                Toast.Show("Transcript deleted", ToastSeverity.Success);
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Toast.Show($"Error deleting transcript: {ex.Message}", ToastSeverity.Error);
        }
    }
}
