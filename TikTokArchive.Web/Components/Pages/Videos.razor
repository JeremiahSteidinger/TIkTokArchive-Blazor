@page "/videos"
@inject TikTokArchive.Web.Services.IVideoService VideoService
@inject TikTokArchive.Web.Services.VideoIngestQueue IngestQueue
@inject ToastService Toast
@inject NavigationManager Nav
@using TikTokArchive.Entities
@using TikTokArchive.Web.Services
@implements IDisposable

<div class="space-y-4">
    <!-- Add Video -->
    <div class="card">
        <div class="flex items-center justify-between">
            <h2 class="text-lg font-semibold text-ink">Add Video</h2>
            <button class="icon-btn" @onclick="@(() => showAddVideo = !showAddVideo)"
                    title="@(showAddVideo ? "Hide" : "Add video")">
                <Icon Name="@(showAddVideo ? "minus" : "plus")" />
            </button>
        </div>

        @if (showAddVideo)
        {
            <div class="mt-3 flex flex-col gap-2 sm:flex-row">
                <input class="input" @bind="newVideoUrl" @bind:event="oninput"
                       placeholder="Enter TikTok video URL" aria-label="TikTok Video URL" />
                <button class="btn btn-primary shrink-0" @onclick="SubmitVideo"
                        disabled="@(string.IsNullOrWhiteSpace(newVideoUrl))">
                    Submit
                </button>
            </div>
        }
    </div>

    <!-- Downloads -->
    @if (ingestJobs.Count > 0)
    {
        <div class="card">
            <h3 class="mb-3 text-xs font-semibold uppercase tracking-wide text-muted">Downloads</h3>
            <div class="space-y-2">
                @foreach (var job in ingestJobs)
                {
                    @if (job.Status == IngestJobStatus.Failed)
                    {
                        <div class="alert alert-danger">
                            <Icon Name="error" Class="size-5 shrink-0 text-rose-500" />
                            <div class="min-w-0 flex-1">
                                <p class="break-all">@job.Url</p>
                                <p class="text-xs opacity-80">@job.Error</p>
                            </div>
                            <button class="icon-btn size-7 shrink-0" @onclick="@(() => DismissJob(job))" title="Dismiss">
                                <Icon Name="close" Class="size-4" />
                            </button>
                        </div>
                    }
                    else
                    {
                        <div class="flex items-center gap-3">
                            <span class="spinner size-4"></span>
                            <span class="text-sm text-ink">@JobStatusText(job.Status)</span>
                            <span class="min-w-0 truncate text-xs text-faint">@job.Url</span>
                        </div>
                    }
                }
            </div>
        </div>
    }

    <!-- Search -->
    <div class="card">
        <div class="relative">
            <span class="pointer-events-none absolute inset-y-0 left-3 flex items-center text-faint">
                <Icon Name="search" Class="size-5" />
            </span>
            <input class="input pl-10" @bind="searchQuery" @bind:event="oninput" @onkeyup="HandleSearchKeyUp"
                   placeholder="Search descriptions, creators, or tags" aria-label="Search videos" />
        </div>

        <div class="mt-3 flex flex-wrap items-center gap-2">
            <span class="text-xs text-faint">Search in:</span>
            @foreach (var field in searchFieldOptions)
            {
                var active = searchFields.Contains(field.Key);
                <button class="@($"chip {(active ? "chip-active" : "chip-inactive")}")"
                        @onclick="@(() => ToggleSearchField(field.Key))">
                    @field.Label
                </button>
            }
        </div>
    </div>

    @if (!string.IsNullOrEmpty(selectedTag))
    {
        <div>
            <span class="badge bg-sky-600 text-white">
                Filtered by: @selectedTag
                <button @onclick="ClearTagFilter" class="ml-1 text-sky-100 hover:text-white" aria-label="Clear filter">
                    <Icon Name="close" Class="size-3.5" />
                </button>
            </span>
        </div>
    }
</div>

@if (isLoading)
{
    <div class="mt-8 flex justify-center">
        <span class="spinner size-8"></span>
    </div>
}
else
{
    <div class="mt-6 space-y-5">
        @if (!videos.Any())
        {
            <div class="alert alert-info items-center">
                <Icon Name="info" Class="size-5 shrink-0 text-sky-500" />
                @if (!string.IsNullOrEmpty(selectedTag))
                {
                    <span>No videos found with tag "@selectedTag".</span>
                }
                else
                {
                    <span>No videos found.</span>
                }
            </div>
        }
        else
        {
            <div class="grid grid-cols-[repeat(auto-fill,minmax(300px,1fr))] gap-5">
                @foreach (var video in videos)
                {
                    <VideoCard Video="video"
                               SelectedTag="selectedTag"
                               OnTagSelected="FilterByTag"
                               OnWorkQueued="StartStatusPolling"
                               OnDeleted="HandleVideoDeleted" />
                }
            </div>

            <Pagination CurrentPage="currentPage" TotalPages="totalPages" PageSize="pageSize"
                        TotalItems="totalCount" PageUrl="PageUrl" ItemNoun="videos" />
        }
    </div>
}

@code {
    private static readonly (string Key, string Label)[] searchFieldOptions =
    {
        ("all", "All"),
        ("description", "Description"),
        ("creator", "Creator"),
        ("tags", "Tags"),
        ("transcript", "Transcript"),
        ("summary", "Summary")
    };

    private List<Video> videos = new();
    private HashSet<string> loadedVideos = new();
    private string? selectedTag;
    private bool isLoading = true;
    private string newVideoUrl = string.Empty;
    private bool showAddVideo = false;
    private int currentPage = 1;
    private int pageSize = 20;
    private string searchQuery = string.Empty;
    private List<string> searchFields = new() { "all" };
    private System.Timers.Timer? searchDebounceTimer;
    private int totalCount = 0;
    private int totalPages => (int)Math.Ceiling(totalCount / (double)pageSize);

    private IReadOnlyList<IngestJob> ingestJobs = Array.Empty<IngestJob>();
    private readonly HashSet<Guid> notifiedJobs = new();
    private System.Timers.Timer? jobPollTimer;
    private System.Timers.Timer? statusPollTimer;

    [SupplyParameterFromQuery] public int? Page { get; set; }

    private string PageUrl(int page) => page <= 1 ? "videos" : $"videos?page={page}";

    protected override void OnInitialized()
    {
        // Pick up downloads from a previous visit without re-announcing finished ones;
        // failed jobs stay visible in the panel until dismissed.
        foreach (var job in IngestQueue.GetJobs().Where(j => j.IsFinished))
        {
            notifiedJobs.Add(job.Id);
        }
        RefreshIngestJobList();
        if (ingestJobs.Any(j => !j.IsFinished))
        {
            StartJobPolling();
        }
    }

    // Re-runs on first load and whenever ?page= changes (including browser back/forward),
    // so the grid always reflects the page in the URL.
    protected override async Task OnParametersSetAsync()
    {
        currentPage = Page is int p && p > 0 ? p : 1;
        await LoadVideos();
    }

    private void LoadVideo(string videoId)
    {
        loadedVideos.Add(videoId);
        StateHasChanged();
    }

    // showLoading is suppressed for background status refreshes so the grid isn't briefly
    // replaced by the loading spinner while a poll re-fetches the page.
    private async Task LoadVideos(bool showLoading = true)
    {
        if (showLoading)
        {
            isLoading = true;
        }
        loadedVideos.Clear(); // Clear loaded videos when navigating pages
        try
        {
            var searchQueryParam = string.IsNullOrWhiteSpace(searchQuery) ? null : searchQuery;
            var searchFieldsParam = searchFields.Contains("all") ? null : searchFields;

            var (loadedVideos, count) = await VideoService.GetVideosAsync(currentPage, pageSize, selectedTag, searchQueryParam, searchFieldsParam);
            videos = loadedVideos;
            totalCount = count;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading videos: {ex.Message}");
            videos = new List<Video>();
            totalCount = 0;
        }
        finally
        {
            if (showLoading)
            {
                isLoading = false;
            }
        }

        // Whenever the visible set changes, (re)start polling if any of these videos are still
        // being transcribed or enriched, so their card icons update as the workers finish.
        StartStatusPolling();
    }

    private void HandleSearchKeyUp(KeyboardEventArgs e)
    {
        searchDebounceTimer?.Stop();
        searchDebounceTimer = new System.Timers.Timer(500);
        searchDebounceTimer.Elapsed += async (sender, args) =>
        {
            searchDebounceTimer?.Stop();
            await InvokeAsync(async () =>
            {
                await ResetToFirstPage();
                StateHasChanged();
            });
        };
        searchDebounceTimer.Start();
    }

    private async Task ToggleSearchField(string field)
    {
        if (field == "all")
        {
            searchFields.Clear();
            searchFields.Add("all");
        }
        else
        {
            searchFields.Remove("all");
            if (searchFields.Contains(field))
            {
                searchFields.Remove(field);
                if (searchFields.Count == 0)
                {
                    searchFields.Add("all");
                }
            }
            else
            {
                searchFields.Add(field);
            }
        }

        if (!string.IsNullOrWhiteSpace(searchQuery))
        {
            await ResetToFirstPage();
        }
    }

    private void SubmitVideo()
    {
        try
        {
            IngestQueue.Enqueue(newVideoUrl);
            Toast.Show("Video queued for download", ToastSeverity.Info);
            newVideoUrl = string.Empty;
            RefreshIngestJobList();
            StartJobPolling();
        }
        catch (ArgumentException ex)
        {
            Toast.Show(ex.Message, ToastSeverity.Warning);
        }
    }

    private void StartJobPolling()
    {
        if (jobPollTimer != null) return;

        jobPollTimer = new System.Timers.Timer(2000);
        jobPollTimer.Elapsed += async (sender, args) => await InvokeAsync(RefreshIngestJobsAsync);
        jobPollTimer.Start();
    }

    private void RefreshIngestJobList()
    {
        ingestJobs = IngestQueue.GetJobs()
            .Where(j => !j.IsFinished || (j.Status == IngestJobStatus.Failed && !j.Dismissed))
            .ToList();
    }

    private void DismissJob(IngestJob job)
    {
        job.Dismiss();
        RefreshIngestJobList();
    }

    private async Task RefreshIngestJobsAsync()
    {
        var jobs = IngestQueue.GetJobs();
        var finishedToAnnounce = jobs.Where(j => j.IsFinished && notifiedJobs.Add(j.Id)).ToList();

        foreach (var job in finishedToAnnounce)
        {
            if (job.Status == IngestJobStatus.Completed)
            {
                Toast.Show("Video added successfully!", ToastSeverity.Success);
            }
            else
            {
                Toast.Show($"Video download failed: {job.Error}", ToastSeverity.Error);
            }
        }

        RefreshIngestJobList();

        if (finishedToAnnounce.Any(j => j.Status == IngestJobStatus.Completed))
        {
            await ResetToFirstPage(); // surface the new video at the top of page 1
        }

        if (!ingestJobs.Any(j => !j.IsFinished))
        {
            jobPollTimer?.Stop();
            jobPollTimer?.Dispose();
            jobPollTimer = null;
        }

        StateHasChanged();
    }

    // A video whose transcript or AI summary is still queued will change state when the
    // background worker finishes — those are the cards whose icons we want to keep live.
    private bool HasPendingWork() =>
        videos.Any(v => v.TranscriptStatus == TranscriptStatus.Pending
                     || v.AiSummaryStatus == AiSummaryStatus.Pending);

    private void StartStatusPolling()
    {
        if (statusPollTimer != null || !HasPendingWork()) return;

        statusPollTimer = new System.Timers.Timer(3000);
        statusPollTimer.Elapsed += async (sender, args) => await InvokeAsync(RefreshStatusesAsync);
        statusPollTimer.Start();
    }

    private void StopStatusPolling()
    {
        statusPollTimer?.Stop();
        statusPollTimer?.Dispose();
        statusPollTimer = null;
    }

    private async Task RefreshStatusesAsync()
    {
        var ids = videos.Select(v => v.TikTokVideoId).ToList();
        if (ids.Count == 0)
        {
            StopStatusPolling();
            return;
        }

        List<VideoStatus> statuses;
        try
        {
            statuses = await VideoService.GetStatusesAsync(ids);
        }
        catch
        {
            return; // transient DB hiccup — try again on the next tick
        }

        // Did any visible card's transcript / summary status change since we last loaded?
        var statusById = statuses.ToDictionary(s => s.VideoId);
        var changed = videos.Any(v =>
            statusById.TryGetValue(v.TikTokVideoId, out var s)
            && (s.TranscriptStatus != v.TranscriptStatus || s.AiSummaryStatus != v.AiSummaryStatus));

        if (changed)
        {
            // Reload (without the loading spinner) so the new summary text, transcript, and AI
            // tags arrive with the status — not just the icon. Ordering is stable (newest first),
            // so cards don't jump.
            await LoadVideos(showLoading: false);
            StateHasChanged();
        }

        // Nothing left in flight on this page — stop polling until something is queued again.
        if (!HasPendingWork())
        {
            StopStatusPolling();
        }
    }

    private static string JobStatusText(IngestJobStatus status) => status switch
    {
        IngestJobStatus.Queued => "Queued",
        IngestJobStatus.FetchingMetadata => "Fetching metadata…",
        IngestJobStatus.Downloading => "Downloading…",
        IngestJobStatus.Saving => "Saving…",
        _ => status.ToString()
    };

    public void Dispose()
    {
        searchDebounceTimer?.Dispose();
        jobPollTimer?.Dispose();
        statusPollTimer?.Dispose();
    }

    // A filter change resets to page 1. If we're past page 1, navigate so the URL drops the
    // stale ?page= (which reloads via OnParametersSetAsync); otherwise just reload in place.
    private async Task ResetToFirstPage()
    {
        if (currentPage != 1)
        {
            Nav.NavigateTo(PageUrl(1));
        }
        else
        {
            await LoadVideos();
        }
    }

    private async Task FilterByTag(string tag)
    {
        selectedTag = tag;
        await ResetToFirstPage();
    }

    private async Task ClearTagFilter()
    {
        selectedTag = null;
        await ResetToFirstPage();
    }

    private async Task HandleVideoDeleted()
    {
        // The card already deleted the video and showed a toast; we just fix up paging.
        if (videos.Count == 1 && currentPage > 1)
        {
            // Removed the only card on this page — drop back a page (updates the URL too).
            Nav.NavigateTo(PageUrl(currentPage - 1));
        }
        else
        {
            await LoadVideos();
        }
    }
}
