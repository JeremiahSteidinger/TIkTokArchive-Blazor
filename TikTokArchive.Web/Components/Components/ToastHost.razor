@* Renders the ToastService queue as a fixed stack, bottom-right. Replaces MudSnackbarProvider. *@
@implements IDisposable
@inject ToastService ToastService

<div class="fixed bottom-4 right-4 z-[1100] flex flex-col gap-2">
    @foreach (var toast in ToastService.Toasts)
    {
        var style = StyleFor(toast.Severity);
        <div class="flex w-80 max-w-[calc(100vw-2rem)] items-start gap-3 rounded-lg border @style.Border bg-surface/95 px-4 py-3 shadow-lg shadow-black/20 backdrop-blur dark:shadow-black/40">
            <Icon Name="@style.Icon" Class="@($"size-5 shrink-0 {style.IconColor}")" />
            <p class="flex-1 text-sm leading-snug text-ink">@toast.Message</p>
            <button type="button" @onclick="() => ToastService.Remove(toast.Id)"
                    class="shrink-0 text-faint transition-colors hover:text-ink" aria-label="Dismiss">
                <Icon Name="close" Class="size-4" />
            </button>
        </div>
    }
</div>

@code {
    private readonly HashSet<Guid> _scheduled = new();

    protected override void OnInitialized() => ToastService.OnChange += HandleChange;

    private async void HandleChange()
    {
        foreach (var toast in ToastService.Toasts.ToList())
        {
            if (_scheduled.Add(toast.Id))
            {
                _ = AutoDismissAsync(toast.Id);
            }
        }
        await InvokeAsync(StateHasChanged);
    }

    private async Task AutoDismissAsync(Guid id)
    {
        await Task.Delay(5000);
        ToastService.Remove(id);
    }

    private static (string Icon, string Border, string IconColor) StyleFor(ToastSeverity severity) => severity switch
    {
        ToastSeverity.Success => ("success", "border-emerald-500/40", "text-emerald-500"),
        ToastSeverity.Error   => ("error", "border-rose-500/40", "text-rose-500"),
        ToastSeverity.Warning => ("warning", "border-amber-500/40", "text-amber-500"),
        _                     => ("info", "border-sky-500/40", "text-sky-500"),
    };

    public void Dispose() => ToastService.OnChange -= HandleChange;
}
