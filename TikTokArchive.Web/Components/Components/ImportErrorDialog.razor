@* Modal overlay showing a full local-import error message. Driven by Admin's state. *@
<div class="fixed inset-0 z-[1050] flex items-center justify-center p-4">
    <div class="absolute inset-0 bg-black/60 backdrop-blur-sm" @onclick="OnCloseRequested"></div>
    <div class="relative z-10 flex max-h-[80vh] w-full max-w-3xl flex-col rounded-xl border border-line bg-surface shadow-2xl">
        <div class="flex items-center gap-2 border-b border-line px-5 py-3">
            <Icon Name="error" Class="size-5 shrink-0 text-rose-500" />
            <h2 class="flex-1 truncate text-base font-semibold text-ink">@Title</h2>
            <button class="icon-btn size-8" @onclick="OnCloseRequested" aria-label="Close">
                <Icon Name="close" Class="size-4" />
            </button>
        </div>
        <div class="overflow-y-auto p-4">
            <pre class="whitespace-pre-wrap break-all rounded-lg bg-page p-3 font-mono text-xs leading-relaxed text-muted">@ErrorMessage</pre>
        </div>
        <div class="flex justify-end border-t border-line px-5 py-3">
            <button class="btn btn-ghost" @onclick="OnCloseRequested">Close</button>
        </div>
    </div>
</div>

@code {
    [Parameter] public string Title { get; set; } = "Import Error";
    [Parameter] public string ErrorMessage { get; set; } = string.Empty;
    [Parameter] public EventCallback OnClose { get; set; }

    private Task OnCloseRequested() => OnClose.InvokeAsync();
}
